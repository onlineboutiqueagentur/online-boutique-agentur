---
/**
 * Croissant als feine Linienzeichnung (Monoline, kein Cartoon) – Platzhalter, bis ein
 * hochwertiges Croissant-Foto vorliegt. Die Schichten stehen für die Zutaten einer Marke.
 * Mit `draw` zeichnet sich die Kontur und danach Schicht für Schicht von der Mitte nach außen,
 * sobald die Grafik sichtbar wird (Klasse .is-in aus scripts/reveal.ts).
 * Ohne JS bzw. bei reduced motion ist die Zeichnung sofort vollständig da.
 */
interface Props {
  class?: string;
  draw?: boolean;
  /** Klein (z. B. im Button): nur Kontur + die mittleren Schichten */
  mini?: boolean;
  /** Ohne label rein dekorativ (aria-hidden) */
  label?: string;
}
const { class: className, draw = false, mini = false, label } = Astro.props;

const outline = 'M30 190 Q24.5 149.7 60 116 Q65.4 84.5 104 76 Q119.3 47.7 156 54 Q200 27.6 244 54 Q280.7 47.7 296 76 Q334.6 84.5 340 116 Q375.5 149.7 370 190 Q347.4 180.9 330 172 Q308.6 166.3 292 160 Q265.2 156.4 244 151 Q200 156.3 156 151 Q134.8 156.4 108 160 Q91.4 166.3 70 172 Q52.6 180.9 30 190 Z';
const layers = [
  {
    d: 'M156 54 Q166 102.5 156 151',
    step: 1
  },
  {
    d: 'M244 54 Q234 102.5 244 151',
    step: 1
  },
  {
    d: 'M104 76 Q116 118 108 160',
    step: 2
  },
  {
    d: 'M296 76 Q284 118 292 160',
    step: 2
  },
  {
    d: 'M60 116 Q75 144 70 172',
    step: 3
  },
  {
    d: 'M340 116 Q325 144 330 172',
    step: 3
  }
];
const texture = [
  {
    d: 'M72.8 135.7 Q79.2 124.9 97.5 119.3',
    step: 4
  },
  {
    d: 'M115.8 110.6 Q126.1 100.7 146 100.9',
    step: 4
  },
  {
    d: 'M173.6 85 Q200 73.4 226.4 85',
    step: 4
  },
  {
    d: 'M173.6 112.2 Q200 100.6 226.4 112.2',
    step: 4
  },
  {
    d: 'M254 100.9 Q273.9 100.7 284.2 110.6',
    step: 4
  },
  {
    d: 'M302.5 119.3 Q320.8 124.9 327.2 135.7',
    step: 4
  }
];
---

<svg
  class:list={['croissant-art', { 'croissant-art--draw': draw }, className]}
  data-reveal-at={draw ? '0.7' : undefined}
  viewBox={draw ? "18 20 364 176" : "0 0 400 230"}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path class="croissant-art__fill" d={outline} />
  <path class="croissant-art__line croissant-art__outline" d={outline} pathLength={draw ? undefined : 1} style="--step:0" />
  {(mini ? layers.slice(0, 4) : layers).map((l) => <path class="croissant-art__line" d={l.d} pathLength={draw ? undefined : 1} style={`--step:${l.step}`} />)}
  {!mini && texture.map((t) => <path class="croissant-art__line croissant-art__texture" d={t.d} pathLength={draw ? undefined : 1} style={`--step:${t.step}`} />)}
</svg>

<script>
  // Länge jeder Linie messen, damit sie sich in jedem Browser vollständig zeichnet
  document.querySelectorAll<SVGPathElement>('.croissant-art--draw .croissant-art__line').forEach((path) => {
    path.style.setProperty('--len', String(Math.ceil(path.getTotalLength()) + 2));
  });
</script>

<style>
  .croissant-art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .croissant-art__fill {
    fill: var(--croissant-fill, transparent);
    stroke: none;
  }
  .croissant-art__line {
    fill: none;
    stroke: var(--croissant-ink, currentColor);
    stroke-width: var(--croissant-stroke, 1.5);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .croissant-art__texture {
    opacity: 0.45;
  }

  /*
   * Gezeichnete Variante: ohne non-scaling-stroke (sonst erscheint die Linie nur in Bruchstücken).
   * Die echte Länge jeder Linie misst ein kleines Skript (--len) – zuverlässiger als pathLength,
   * das nicht jeder Browser beim Strichmuster berücksichtigt. Strichstärke in SVG-Einheiten (fein).
   */
  .croissant-art--draw .croissant-art__line {
    vector-effect: none;
    stroke-width: var(--croissant-stroke-draw, 1.2);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Startzustand sofort (ohne Übergang) unsichtbar … */
    :global(.anim-ready) .croissant-art--draw .croissant-art__line {
      stroke-dasharray: var(--len, 2000);
      stroke-dashoffset: var(--len, 2000);
    }
    :global(.anim-ready) .croissant-art--draw .croissant-art__fill {
      opacity: 0;
    }
    /* … und erst beim Sichtbarwerden wie von Hand gemalt: in einem Zug die Kontur,
       dann Schicht für Schicht von der Mitte nach außen */
    :global(.anim-ready) .croissant-art--draw:global(.is-in) .croissant-art__line {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.8s cubic-bezier(0.45, 0, 0.25, 1);
      transition-delay: calc(1.2s + (var(--step) - 1) * 0.32s);
    }
    :global(.anim-ready) .croissant-art--draw:global(.is-in) .croissant-art__outline {
      transition-duration: 1.6s;
      transition-delay: 0.05s;
    }
    :global(.anim-ready) .croissant-art--draw:global(.is-in) .croissant-art__fill {
      opacity: 1;
      transition: opacity 1s ease 1.6s;
    }
  }
</style>
