---
/**
 * Runde, schwebende Einladung rechts am Rand (Croissant + „Einladung“). Bei Mouse-over/Fokus fährt
 * die Info nach links aus. Erscheint erst, wenn keines der hideNear-Elemente im Bild ist
 * (z. B. Header oder andere Einladungs-Buttons), und lässt sich schließen (gilt für die ganze Sitzung).
 */
import CroissantArt from './CroissantArt.astro';

interface Props {
  href: string;
  label: string;
  meta: string;
  /** CSS-Selektoren: solange eines davon sichtbar ist, bleibt die Einladung ausgeblendet */
  hideNear: string[];
}
const { href, label, meta, hideNear } = Astro.props;
---

<div class="sticky-invite" data-sticky-cta data-hide-near={JSON.stringify(hideNear)}>
  <a class="sticky-invite__link" href={href}>
    <span class="sticky-invite__info">
      <strong>{label}</strong>
      <small>{meta}</small>
    </span>
    <span class="sticky-invite__badge" aria-hidden="true">
      <CroissantArt mini class="sticky-invite__icon" />
      <span class="sticky-invite__label">Einladung</span>
    </span>
  </a>
  <button class="sticky-invite__close" type="button" aria-label="Einladung ausblenden" data-sticky-close>×</button>
</div>

<script>
  const sticky = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const DISMISS_KEY = 'oba-croissant-sticky';
  let dismissed = false;
  try {
    dismissed = sessionStorage.getItem(DISMISS_KEY) === '1';
  } catch {
    // Speicher nicht verfügbar
  }
  if (sticky && !dismissed) {
    const selectors: string[] = JSON.parse(sticky.dataset.hideNear ?? '[]');
    const targets = selectors.map((sel) => document.querySelector(sel)).filter((el): el is Element => !!el);
    const inView = new Set<Element>(targets);
    const update = () => sticky.classList.toggle('is-visible', !dismissed && inView.size === 0);
    sticky.querySelector('[data-sticky-close]')?.addEventListener('click', () => {
      dismissed = true;
      update();
      try {
        sessionStorage.setItem(DISMISS_KEY, '1');
      } catch {
        // ignorieren
      }
    });
    if (targets.length) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inView.add(entry.target);
          else inView.delete(entry.target);
        }
        update();
      });
      targets.forEach((el) => io.observe(el));
    } else {
      update();
    }
  }
</script>

<style>
  /* ---------- Sticky-Einladung (rund, rechts am Rand) ---------- */
  .sticky-invite {
    --badge: 6rem;
    position: fixed;
    /* etwas unterhalb der Mitte und ein Stück vom Rand in die Seite gerückt */
    right: max(clamp(1.75rem, 3.5vw, 3.5rem), env(safe-area-inset-right));
    top: 64%;
    z-index: 30;
    translate: calc(100% + 2rem) -50%;
    opacity: 0;
    visibility: hidden;
    transition:
      translate 0.5s var(--ease),
      opacity 0.3s var(--ease),
      visibility 0s linear 0.5s;
  }
  .sticky-invite.is-visible {
    translate: 0 -50%;
    opacity: 1;
    visibility: visible;
    transition:
      translate 0.5s var(--ease),
      opacity 0.3s var(--ease);
  }
  .sticky-invite__link {
    display: flex;
    align-items: center;
    border-radius: 999px;
    background: var(--c-ink);
    color: var(--c-bg);
    text-decoration: none;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.22);
  }
  /* Info fährt nach links aus */
  .sticky-invite__info {
    display: grid;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    line-height: 1.25;
    opacity: 0;
    transition:
      max-width 0.45s var(--ease),
      padding 0.45s var(--ease),
      opacity 0.25s ease;
  }
  .sticky-invite__info strong {
    font-size: 0.875rem;
    font-weight: var(--w-bold);
    letter-spacing: 0.06em;
  }
  .sticky-invite__info small {
    font-size: 0.75rem;
    opacity: 0.75;
  }
  .sticky-invite__badge {
    display: grid;
    flex: none;
    place-content: center;
    justify-items: center;
    gap: 0.2rem;
    width: var(--badge);
    height: var(--badge);
    border-radius: 50%;
  }
  .sticky-invite :global(.sticky-invite__icon) {
    width: 2.4rem;
    transform-origin: 50% 70%;
    transition: rotate 0.3s var(--ease);
  }
  .sticky-invite.is-visible :global(.sticky-invite__icon) {
    animation: c-sticky-wiggle 4s ease-in-out 0.6s infinite;
  }
  .sticky-invite__label {
    font-size: 0.65rem;
    font-weight: var(--w-bold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  @media (hover: hover) {
    .sticky-invite__link:hover .sticky-invite__info,
    .sticky-invite__link:focus-visible .sticky-invite__info {
      max-width: 17rem;
      padding-left: 1.4rem;
      padding-right: 0.25rem;
      opacity: 1;
      transition:
        max-width 0.45s var(--ease),
        padding 0.45s var(--ease),
        opacity 0.3s ease 0.15s;
    }
    .sticky-invite__link:hover :global(.sticky-invite__icon) {
      rotate: -12deg;
    }
  }
  .sticky-invite__close {
    position: absolute;
    top: -0.35rem;
    right: -0.35rem;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid color-mix(in srgb, var(--c-ink) 20%, transparent);
    border-radius: 50%;
    background: var(--c-bg);
    color: var(--c-ink);
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
  }
  /* Kleiner Klickbereich-Puffer für Touch (mind. 24 px Ziel, mit Rand ca. 44 px) */
  .sticky-invite__close::before {
    content: '';
    position: absolute;
    inset: -0.5rem;
  }
  @media (hover: hover) {
    .sticky-invite__close {
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .sticky-invite:hover .sticky-invite__close,
    .sticky-invite:focus-within .sticky-invite__close {
      opacity: 1;
    }
  }
  .sticky-invite__link:focus-visible,
  .sticky-invite__close:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
  }
  :global(:root[data-design='louder']) .sticky-invite__link {
    background: #000;
    color: var(--c-accent);
  }
  @keyframes c-sticky-wiggle {
    0%,
    80%,
    100% {
      transform: rotate(0);
    }
    85% {
      transform: rotate(-12deg);
    }
    90% {
      transform: rotate(10deg);
    }
    95% {
      transform: rotate(-6deg);
    }
  }
  @media (max-width: 47.99rem) {
    .sticky-invite {
      --badge: 5.5rem;
      right: 1.5rem;
      top: auto;
      bottom: 5rem;
      translate: calc(100% + 2rem) 0;
    }
    .sticky-invite.is-visible {
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-invite,
    .sticky-invite.is-visible,
    .sticky-invite__info {
      transition: none;
    }
    .sticky-invite.is-visible :global(.sticky-invite__icon) {
      animation: none;
    }
  }
</style>
