---
/** Einstieg der Landingpage /entdecken/: Vollbild-Foto, Marke, Headline, Subline, Button. */
import { Picture } from 'astro:assets';
import Navigation from '../Navigation.astro';
import { entdecken } from '../../content/entdecken';
import { insights } from '../../content/site';
const h = entdecken.hero;
---

<header class="e-hero" id="top">
  <div class="e-hero__media">
    <Picture src={insights.image.src} alt="" widths={[960, 1440, 1920]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" decoding="async" />
  </div>
  <Navigation base="/" />
  <div class="e-hero__content parallax-hero">
    <a class="e-hero__brand" href="/">Online <em>Boutique</em> Agentur<sup aria-hidden="true">²</sup></a>
    <h1 class="e-hero__title" set:html={h.titleHtml} />
    <p class="e-hero__sub">{h.sub}</p>
    <a class="btn e-hero__btn" href="#leistungen">{h.cta}</a>
  </div>
</header>

<style>
  .e-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: max(37.5rem, 100svh);
    clip-path: inset(0);
    background: #ddd8d1;
    color: #fff;
  }
  .e-hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .e-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  @media (min-width: 64rem) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .e-hero__media {
      position: fixed;
      height: 100vh;
    }
  }
  .e-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(#0000001a, #00000026 40%, #00000080);
  }
  .e-hero :global(.nav__list),
  .e-hero :global(.nav-toggle),
  .e-hero__content {
    text-shadow: 0 1px 2px #00000040, 0 0 24px #00000047;
  }
  .e-hero :global(.nav__list a),
  .e-hero :global(.nav-toggle) {
    color: #fff;
  }
  .e-hero__content {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    align-self: end;
    width: min(100% - 2 * var(--gutter), 50rem);
    margin-inline: auto;
    padding-bottom: clamp(4rem, 14vh, 9rem);
    text-align: center;
  }
  .e-hero__brand {
    font-family: var(--f-display);
    font-size: 1.05rem;
    text-decoration: none;
  }
  .e-hero__title {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: var(--fs-hero);
    line-height: 1.12;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  .e-hero__title :global(em) {
    font-style: italic;
  }
  .e-hero__sub {
    max-width: 38rem;
    font-weight: var(--w-regular);
    font-size: var(--fs-hero-sub);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .e-hero__btn {
    margin-top: 0.5rem;
    border-color: #fff;
    color: #fff;
    text-shadow: none;
  }
  .e-hero__btn:hover {
    background: #fff;
    color: #000;
  }
  :global(:root[data-design='louder']) .e-hero__brand {
    font-family: var(--f-bold);
    font-size: 1.5rem;
    letter-spacing: 1px;
    color: var(--c-accent);
  }
  :global(:root[data-design='louder']) .e-hero__brand em,
  :global(:root[data-design='louder']) .e-hero__title :global(em) {
    font-style: normal;
  }
  :global(:root[data-design='louder']) .e-hero__title {
    font-family: var(--f-bold);
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: 1px;
    text-transform: lowercase;
  }
  :global(:root[data-design='louder']) .e-hero__title :global(em) {
    color: var(--c-accent);
  }
  :global(:root[data-design='louder']) .e-hero__btn {
    border-color: var(--c-accent);
    background: var(--c-accent);
    color: #000;
  }
  :global(:root[data-design='louder']) .e-hero__btn:hover {
    border-color: #000;
    background: #000;
    color: var(--c-accent);
  }
</style>
