---
/** „Vielleicht fehlt deiner Marke nur das gewisse Extra.“ – Überleitung zum Croissant-Prinzip (Landingpage /entdecken/). */
import CroissantArt from '../CroissantArt.astro';
import { entdecken } from '../../content/entdecken';
const f = entdecken.final;
---

<section class="e-final" aria-labelledby="e-croissant">
  <div class="v-line" aria-hidden="true"></div>
  <div class="container--text e-final__inner">
    <CroissantArt draw class="e-final__art" label="Feine Linienzeichnung eines Croissants" />
    <h2 class="heading e-final__title" id="e-croissant" set:html={f.titleHtml} />
    <div class="e-final__text">
      {f.paragraphsHtml.map((p) => <p set:html={p} />)}
    </div>
    <a class="btn btn--solid e-cta" href="/croissant/">
      <CroissantArt mini class="e-cta__icon" />
      {f.cta}
    </a>
    <a class="e-principle" href="/croissant/">{f.link}</a>
  </div>
</section>

<style>
  .e-final {
    padding-bottom: clamp(4rem, 9vw, 6.5rem);
  }
  .e-final__inner {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    text-align: center;
  }
  .e-final__inner :global(.e-final__art) {
    width: min(55%, 13rem);
    color: var(--c-ink);
  }
  :global(:root[data-design='louder']) .e-final__inner :global(.e-final__art) {
    color: #000;
  }
  .e-final__text {
    display: grid;
    gap: 0.75rem;
    max-width: 38rem;
    font-size: 1.0625rem;
    text-wrap: pretty;
  }
  .e-final__text :global(b) {
    font-weight: var(--w-bold);
  }
  :global(:root[data-design='louder']) .e-final__title {
    font-family: var(--f-bold);
    font-size: var(--fs-h2);
    letter-spacing: 2px;
    text-transform: lowercase;
    color: var(--c-heading);
  }
  :global(:root[data-design='louder']) .e-final__title :global(em) {
    font-style: normal;
  }
  .e-cta {
    gap: 0.6rem;
    margin-top: 0.75rem;
    padding-inline: 1.5rem;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }
  .e-cta :global(.e-cta__icon) {
    width: 1.6rem;
    color: inherit;
    --croissant-fill: transparent;
    --croissant-stroke: 1.4;
    transition: transform 0.4s var(--ease);
  }
  .e-cta:hover :global(.e-cta__icon) {
    transform: rotate(-12deg) scale(1.08);
  }
  .e-principle {
    border-bottom: 1px solid;
    font-size: 0.9375rem;
    font-weight: var(--w-regular);
    text-decoration: none;
  }
</style>
