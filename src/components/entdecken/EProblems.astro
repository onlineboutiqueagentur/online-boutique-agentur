---
/** „Hand aufs Herz. Spürst du dieses Kribbeln noch?“ – fünf Aussagen mit feinen Symbolen (Landingpage /entdecken/). */
import SectionHead from '../SectionHead.astro';
import { entdecken } from '../../content/entdecken';
const p = entdecken.problems;
---

<section class="e-block" id="bekannt" aria-labelledby="e-problems">
  <SectionHead id="e-problems" titleHtml={p.titleHtml} textHtml={p.textHtml} />
  <ul role="list" class="e-calm container--text">
    {
      p.items.map((item) => (
        <li class="e-calm__item reveal-up">
          <span class="e-calm__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              {item.icon === 'browser' && (
                <>
                  <rect x="3" y="4.5" width="18" height="15" rx="2" />
                  <path d="M3 9h18" />
                  <circle cx="6" cy="6.75" r=".4" />
                  <circle cx="8" cy="6.75" r=".4" />
                  <path d="M7 13h6M7 16h4" />
                </>
              )}
              {item.icon === 'sprout' && (
                <>
                  <path d="M12 20v-9" />
                  <path d="M12 11c0-3.5 2.5-6 6.5-6 0 3.5-2.5 6-6.5 6Z" />
                  <path d="M12 14c0-2.8-2-4.8-5.5-4.8 0 2.8 2 4.8 5.5 4.8Z" />
                  <path d="M8 20h8" />
                </>
              )}
              {item.icon === 'eye' && (
                <>
                  <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" />
                  <circle cx="12" cy="12" r="3" />
                </>
              )}
              {item.icon === 'bulb' && (
                <>
                  <path d="M9 17.5h6M10 20.5h4" />
                  <path d="M12 3.5a6 6 0 0 0-3.6 10.8c.6.5 1 1.3 1 2.1v1.1h5.2v-1.1c0-.8.4-1.6 1-2.1A6 6 0 0 0 12 3.5Z" />
                </>
              )}
              {item.icon === 'compass' && (
                <>
                  <circle cx="12" cy="12" r="8.5" />
                  <path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" />
                </>
              )}
            </svg>
          </span>
          <span>{item.text}</span>
          <em>{item.em}</em>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .e-block {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .e-calm {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    text-align: center;
  }
  .e-calm__item {
    display: grid;
    gap: 0.2rem;
  }
  .e-calm__item span {
    font-size: 1rem;
  }
  .e-calm__icon {
    justify-self: center;
    margin-bottom: 0.6rem;
  }
  .e-calm__icon svg {
    display: block;
    width: 1.9rem;
  }
  :global(:root[data-design='louder']) .e-calm__icon {
    color: #000;
  }
  .e-calm__item em {
    font-family: var(--f-display);
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.4;
    text-wrap: balance;
  }
  :global(:root[data-design='louder']) .e-calm__item em {
    font-family: var(--f-bold);
    font-style: normal;
    letter-spacing: 1px;
    text-transform: lowercase;
  }
</style>
