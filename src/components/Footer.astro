---
import { agency, footer, tracking } from '../content/site';
import DesignSwitch from './DesignSwitch.astro';
import WhatsApp from './WhatsApp.astro';

interface Props {
  /** false: ohne Kontaktblock – der WhatsApp-Button sitzt dann in der Fußleiste (z. B. /croissant) */
  contact?: boolean;
}
const { contact = true } = Astro.props;
const hasTracking = Boolean(tracking.ga4MeasurementId);
---

<footer class="site-footer">
  {contact && (
  <address class="site-footer__contact">
    <p class="site-footer__name">{agency.name}</p>
    <!-- Anschrift bewusst nur im Impressum (kein Standort mit Kundenverkehr) -->
    <p>{agency.owner}</p>
    <p>
      <a href={`mailto:${agency.email}`}>{agency.email}</a><br />
      <a href={`tel:${agency.phoneE164}`}>{agency.phone}</a>
    </p>
    <WhatsApp />
  </address>
  )}

  <div class="site-footer__bar">
    <p>
      {footer.copyright} | <a href="/impressum/">Impressum</a> | <a href="/datenschutz/">Datenschutz</a> | <a href="/kontakt/">Kontakt</a>
      {hasTracking && (
        <>
          {' '}| <button type="button" class="site-footer__link-btn" data-consent-open>Cookie-Einstellungen</button>
        </>
      )}
    </p>
    {!contact && <div class="site-footer__wa"><WhatsApp /></div>}
    <DesignSwitch variant="footer" />
  </div>

  <a class="to-top" href="#top"><span class="sr-only">Nach oben</span>
    <svg viewBox="0 0 16 10" width="16" height="10" aria-hidden="true" focusable="false"><path d="M1 9l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
  </a>
</footer>

<style>
  .site-footer__contact {
    display: grid;
    justify-items: center;
    gap: 1.2rem;
    padding: 2.5rem var(--gutter) 4rem;
    font-style: normal;
    text-align: center;
  }
  .site-footer__name {
    font-family: var(--f-serif);
    font-size: 1.8125rem;
    letter-spacing: -1px;
    line-height: 1;
  }
  .site-footer__contact a:not(.whatsapp) {
    text-decoration: none;
  }
  .site-footer__contact a:not(.whatsapp):hover {
    text-decoration: underline;
  }

  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    min-height: 106px;
    padding: 1.75rem var(--gutter) 2rem;
    background: var(--c-footer-bg);
    color: var(--c-footer-ink);
    text-align: center;
  }
  .site-footer__bar a {
    text-decoration: none;
  }
  .site-footer__bar a:hover {
    text-decoration: underline;
  }
  /* WhatsApp in der dunklen Fußleiste */
  .site-footer__wa :global(.whatsapp) {
    background: rgb(255 255 255 / 0.1);
    color: inherit;
  }
  .site-footer__wa :global(.whatsapp:hover) {
    background: rgb(255 255 255 / 0.2);
    text-decoration: none;
  }
  .site-footer__link-btn {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    width: 48px;
    height: 35px;
    border-radius: 4px 4px 0 0;
    background: #333;
    color: #fff;
  }
  @supports (animation-timeline: scroll()) {
    .to-top {
      animation: to-top-in linear both;
      animation-timeline: scroll();
      animation-range: 0 100vh;
    }
  }
  @keyframes to-top-in {
    0% { opacity: 0; visibility: hidden; transform: translateY(100%); }
    100% { opacity: 1; visibility: visible; transform: none; }
  }
</style>
