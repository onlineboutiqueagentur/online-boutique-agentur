---
import { agency, footer, tracking } from '../content/site';
import DesignSwitch from './DesignSwitch.astro';

const hasTracking = Boolean(tracking.ga4MeasurementId);
---

<footer class="site-footer">
  <address class="site-footer__contact">
    <p class="site-footer__name">{agency.name}</p>
    <p>
      {agency.owner}<br />
      {agency.address.street}. {agency.address.zip} {agency.address.city}
    </p>
    <p>
      <a href={`mailto:${agency.email}`}>{agency.email}</a><br />
      <a href={`tel:${agency.phoneE164}`}>{agency.phone}</a>
    </p>
    <a class="whatsapp" href={agency.whatsapp} target="_blank" rel="noopener">
      <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="16" fill="#25d366"></circle>
        <path fill="#fff" d="M23.3 8.7A10.3 10.3 0 0 0 7 21.1L5.6 26.4l5.4-1.4a10.3 10.3 0 0 0 4.9 1.3 10.3 10.3 0 0 0 7.3-17.6zM16 24.6a8.5 8.5 0 0 1-4.4-1.2l-.3-.2-3.2.8.9-3.1-.2-.3A8.6 8.6 0 1 1 16 24.6zm4.7-6.4c-.3-.1-1.5-.7-1.8-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a7 7 0 0 1-3.5-3c-.3-.5.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3z"></path>
      </svg>
      {footer.whatsappLabel}
      <span class="sr-only">(öffnet WhatsApp in neuem Fenster)</span>
    </a>
  </address>

  <div class="site-footer__bar">
    <p>
      {footer.copyright} | <a href="/impressum/">Impressum</a> | <a href="/datenschutz/">Datenschutz</a>
      {hasTracking && (
        <>
          {' '}| <button type="button" class="site-footer__link-btn" data-consent-open>Cookie-Einstellungen</button>
        </>
      )}
    </p>
    <DesignSwitch variant="footer" />
  </div>

  <a class="to-top" href="#top"><span class="sr-only">Nach oben</span>
    <svg viewBox="0 0 16 10" width="16" height="10" aria-hidden="true" focusable="false"><path d="M1 9l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
  </a>
</footer>

<style>
  .site-footer__contact {
    display: grid;
    justify-items: center;
    gap: 1.2rem;
    padding: 2.5rem var(--gutter) 4rem;
    font-style: normal;
    text-align: center;
  }
  .site-footer__name {
    font-family: var(--f-serif);
    font-size: 1.8125rem;
    letter-spacing: -1px;
    line-height: 1;
  }
  .site-footer__contact a:not(.whatsapp) {
    text-decoration: none;
  }
  .site-footer__contact a:not(.whatsapp):hover {
    text-decoration: underline;
  }
  .whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.4rem 1rem 0.4rem 0.5rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.07);
    font-size: 0.875rem;
    font-weight: var(--w-regular);
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease);
  }
  .whatsapp:hover {
    background: rgb(0 0 0 / 0.13);
  }

  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    min-height: 106px;
    padding: 1.75rem var(--gutter) 2rem;
    background: var(--c-footer-bg);
    color: var(--c-footer-ink);
    text-align: center;
  }
  .site-footer__bar a {
    text-decoration: none;
  }
  .site-footer__bar a:hover {
    text-decoration: underline;
  }
  .site-footer__link-btn {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    width: 48px;
    height: 35px;
    border-radius: 4px 4px 0 0;
    background: #333;
    color: #fff;
  }
  @supports (animation-timeline: scroll()) {
    .to-top {
      animation: to-top-in linear both;
      animation-timeline: scroll();
      animation-range: 0 100vh;
    }
  }
  @keyframes to-top-in {
    0% { opacity: 0; visibility: hidden; transform: translateY(100%); }
    100% { opacity: 1; visibility: visible; transform: none; }
  }
</style>
