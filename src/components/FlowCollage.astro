---
/**
 * feel – flow – grow: versetzte Bildcollage (drei Bilder; „glow“ wurde entfernt).
 * Nebeneinander in drei Spalten, leicht höhenversetzt – auf allen Bildschirmen.
 */
import { flowImages } from '../content/site';
import ThemedPicture from './ThemedPicture.astro';

// Scroll-Bewegung wie im Original: feel ↑ (+ Unschärfe beim Verlassen), flow ruhig, grow ↓
// parallax-mobile: Bewegung auch am Handy (dort mit kürzerem Weg)
const motion = ['parallax-up blur-out parallax-mobile', '', 'parallax-down parallax-mobile'];
---

<div class="collage" role="list" aria-label="feel – flow – grow">
  {
    flowImages.map((image, i) => (
      <figure class:list={['collage__item', `collage__item--${i + 1}`, motion[i]]} role="listitem">
        <div class={i === 1 ? 'bounce-left' : 'reveal'}>
          <ThemedPicture image={image} widths={[320, 480, 640, 960]} sizes="(min-width: 64rem) 460px, 50vw" />
        </div>
      </figure>
    ))
  }
</div>

<style>
  /* Drei Bilder nebeneinander, leicht höhenversetzt (Collage-Charakter) */
  .collage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
    width: min(100% - 2 * var(--gutter), 66rem);
    margin: 0 auto;
  }
  .collage__item :global(img) {
    width: 100%;
    aspect-ratio: 6 / 7;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .collage__item--1 { margin-top: 2rem; }
  .collage__item--2 { margin-top: 0; }
  .collage__item--3 { margin-top: 4rem; }

  @media (max-width: 47.99rem) {
    .collage {
      gap: 0.75rem;
    }
    .collage__item--1 { margin-top: 1rem; }
    .collage__item--3 { margin-top: 2rem; }
  }
</style>
