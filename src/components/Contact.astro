---
import { contact } from '../content/site';
import ContactForm from './ContactForm.astro';
import BreakfastForm from './BreakfastForm.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  /** Test-Startseite: Frühstücks-Einladung – Überschrift zentriert mit Strich über der Sektion,
      darunter Video + Formular der Croissant-Seite */
  breakfast?: boolean;
}
const { breakfast = false } = Astro.props;
const b = contact.breakfast;
---

{
  breakfast ? (
    <section class="contact-b" id="kontakt" aria-labelledby="kontakt-title">
      <SectionHead id="kontakt-title" titleHtml={b.titleHtml} textHtml={b.textHtml} />
      <div class="contact contact--b">
        <div class="contact__media">
          <video class="contact__video" muted loop playsinline preload="none" data-src={contact.video.src} aria-label={contact.video.label}></video>
        </div>
        <div class="contact__main">
          <BreakfastForm />
        </div>
      </div>
    </section>
  ) : (
    <section class="contact" id="kontakt" aria-labelledby="kontakt-title">
      <div class="contact__media">
        <video class="contact__video" muted loop playsinline preload="none" data-src={contact.video.src} aria-label={contact.video.label}></video>
      </div>

      <div class="contact__main">
        <h2 class="heading heading--serif contact__title" id="kontakt-title" set:html={contact.titleHtml} />
        <p class="lead-text">{contact.text}</p>

        <ContactForm />
      </div>
    </section>
  )
}

<script>

  // Video erst laden, wenn es in die Nähe des Viewports kommt (spart ~4 MB beim Seitenaufruf)
  const video = document.querySelector<HTMLVideoElement>('.contact__video');
  if (video) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    new IntersectionObserver(
      ([entry], obs) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        video.src = video.dataset.src ?? '';
        if (reduced) {
          video.controls = true;
          video.preload = 'metadata';
        } else {
          video.autoplay = true;
          video.play().catch(() => (video.controls = true));
        }
      },
      { rootMargin: '400px' },
    ).observe(video);
  }
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    width: min(100% - 2 * var(--gutter), 72rem);
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 6.5rem) 0 3rem;
  }
  .contact__media {
    display: flex;
    justify-content: center;
  }
  .contact__video {
    width: min(100%, 27.6rem);
    aspect-ratio: 442 / 516;
    object-fit: cover;
    border-radius: var(--radius);
    background: rgb(0 0 0 / 0.08);
  }
  /* Frühstücks-Variante: einspaltig und zentriert – Überschrift, Video, Formular */
  .contact-b :global(.section-head__text) {
    max-width: 34rem;
    margin-inline: auto;
    text-wrap: pretty;
  }
  .contact.contact--b {
    grid-template-columns: 1fr;
    justify-items: center;
    gap: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .contact--b .contact__video {
    width: min(100%, 24rem);
  }
  .contact--b .contact__main {
    width: min(100%, 34rem);
    text-align: center;
  }
  .contact--b .contact__main :global(.form__field),
  .contact--b .contact__main :global(.form__privacy) {
    text-align: left;
  }
  .contact--b .contact__main :global(.form__actions) {
    justify-content: center;
  }
  .contact__title {
    font-size: var(--fs-h2-lg);
  }
  :global(:root[data-design='louder']) .contact__title {
    font-family: var(--f-bold);
    font-size: var(--fs-h2);
    letter-spacing: 2px;
    text-transform: lowercase;
    color: var(--c-heading);
  }


  @media (max-width: 47.99rem) {
    .contact {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
