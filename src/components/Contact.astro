---
import { contact } from '../content/site';
import ContactForm from './ContactForm.astro';
---

<section class="contact" id="kontakt" aria-labelledby="kontakt-title">
  <div class="contact__media">
    <video class="contact__video" muted loop playsinline preload="none" data-src={contact.video.src} aria-label={contact.video.label}></video>
  </div>

  <div class="contact__main">
    <h2 class="heading heading--serif contact__title" id="kontakt-title" set:html={contact.titleHtml} />
    <p class="lead-text">{contact.text}</p>

    <ContactForm />
  </div>
</section>

<script>

  // Video erst laden, wenn es in die Nähe des Viewports kommt (spart ~4 MB beim Seitenaufruf)
  const video = document.querySelector<HTMLVideoElement>('.contact__video');
  if (video) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    new IntersectionObserver(
      ([entry], obs) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        video.src = video.dataset.src ?? '';
        if (reduced) {
          video.controls = true;
          video.preload = 'metadata';
        } else {
          video.autoplay = true;
          video.play().catch(() => (video.controls = true));
        }
      },
      { rootMargin: '400px' },
    ).observe(video);
  }
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    width: min(100% - 2 * var(--gutter), 72rem);
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 6.5rem) 0 3rem;
  }
  .contact__media {
    display: flex;
    justify-content: center;
  }
  .contact__video {
    width: min(100%, 27.6rem);
    aspect-ratio: 442 / 516;
    object-fit: cover;
    border-radius: var(--radius);
    background: rgb(0 0 0 / 0.08);
  }
  .contact__title {
    font-size: var(--fs-h2-lg);
  }
  :global(:root[data-design='louder']) .contact__title {
    font-family: var(--f-bold);
    font-size: var(--fs-h2);
    letter-spacing: 2px;
    text-transform: lowercase;
    color: var(--c-heading);
  }


  @media (max-width: 47.99rem) {
    .contact {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
