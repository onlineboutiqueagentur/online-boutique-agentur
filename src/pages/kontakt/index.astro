---
/**
 * KONTAKT – freundliche Kontaktseite mit den bestehenden Design-Elementen der Website:
 * zentrierter Einstieg (Subline in Versalien, Headline, senkrechte Linie), Video + Kontaktwege
 * als ruhige Zeilen mit feinen Linien-Icons, Formular auf einer zarten Fläche und
 * ein kleiner Hinweis auf die Croissant-Einladung. Funktioniert in beiden Designwelten.
 */
import Base from '../../layouts/Base.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import ContactForm from '../../components/ContactForm.astro';
import CroissantArt from '../../components/CroissantArt.astro';
import StickyInvite from '../../components/StickyInvite.astro';
import { croissantTeaser } from '../../content/croissant';
import { agency, contact } from '../../content/site';

/** Texte der Kontaktseite (Entwurf – von Nina & Pia freizugeben) */
const k = {
  eyebrow: 'Kontakt',
  title: 'Erzähl uns von',
  titleEm: 'dir.',
  hello: 'Wir freuen uns auf dich!',
  names: 'Nina & Pia · Online Boutique Agentur',
  formTitle: 'Schreib uns ein paar Zeilen.',
  formText: 'Wir melden uns ganz bald bei dir.',
  croissant: 'Lieber bei Kaffee & Croissant?',
  croissantCta: 'Eine Einladung für dich',
};

const ways = [
  { icon: 'mail', label: 'Schreib uns', value: agency.email, href: `mailto:${agency.email}` },
  { icon: 'phone', label: 'Ruf uns an', value: agency.phone, href: `tel:${agency.phoneE164}` },
  { icon: 'chat', label: 'WhatsApp', value: 'Live Chat starten', href: agency.whatsapp, external: true },
] as const;
---

<Base
  title="Kontakt | Online Boutique Agentur, Pasching bei Linz"
  description="Schreib uns: Online Boutique Agentur – Nina & Pia, Pasching bei Linz. Kontaktformular, E-Mail, Telefon und WhatsApp."
  path="/kontakt/"
>
  <header class="k-head" id="top">
    <Navigation base="/" designSwitch />
  </header>

  <main id="inhalt" class="k" tabindex="-1">
    <!-- Einstieg -->
    <section class="k-hero container--text" aria-labelledby="k-title">
      <div class="v-line" aria-hidden="true"></div>
      <p class="k-eyebrow">{k.eyebrow}</p>
      <h1 class="k-title" id="k-title">{k.title} <em>{k.titleEm}</em></h1>
      <p class="k-lead">{contact.text}</p>
    </section>

    <!-- Video + Kontaktwege -->
    <section class="k-intro" aria-label="So erreichst du uns">
      <div class="k-media">
        <video class="k-video" muted loop playsinline preload="none" data-src={contact.video.src} aria-label={contact.video.label}></video>
      </div>
      <div class="k-ways">
        <p class="k-hello">{k.hello}</p>
        <p class="k-names">{k.names}</p>
        <ul role="list" class="k-list">
          {
            ways.map((w) => (
              <li>
                {'href' in w ? (
                  <a class="k-way" href={w.href} target={'external' in w ? '_blank' : undefined} rel={'external' in w ? 'noopener' : undefined}>
                    <span class="k-way__icon" aria-hidden="true">
                      {w.icon === 'mail' && (
                        <svg viewBox="0 0 24 24">
                          <rect x="3" y="5" width="18" height="14" rx="2" />
                          <path d="m4 7 8 6 8-6" />
                        </svg>
                      )}
                      {w.icon === 'phone' && (
                        <svg viewBox="0 0 24 24">
                          <path d="M6.6 3.5h2.6l1.4 4.2-2 1.4a12 12 0 0 0 6.3 6.3l1.4-2 4.2 1.4v2.6a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z" />
                        </svg>
                      )}
                      {w.icon === 'chat' && (
                        <svg viewBox="0 0 24 24">
                          <path d="M20 11.5a8 8 0 0 1-11.7 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5z" />
                        </svg>
                      )}
                    </span>
                    <span class="k-way__text">
                      <span class="k-way__label">{w.label}</span>
                      <span class="k-way__value">{w.value}</span>
                    </span>
                    <span class="k-way__arrow" aria-hidden="true">→</span>
                    {'external' in w && <span class="sr-only">(öffnet in neuem Fenster)</span>}
                  </a>
                ) : (
                  <address class="k-way k-way--static">
                    <span class="k-way__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
                        <circle cx="12" cy="10" r="2.3" />
                      </svg>
                    </span>
                    <span class="k-way__text">
                      <span class="k-way__label">{w.label}</span>
                      <span class="k-way__value">{w.value}</span>
                    </span>
                  </address>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Formular -->
    <section class="k-form" aria-labelledby="k-form-title">
      <div class="v-line" aria-hidden="true"></div>
      <div class="k-form__panel">
        <h2 class="k-form__title" id="k-form-title">{k.formTitle}</h2>
        <p class="k-form__text">{k.formText}</p>
        <ContactForm />
      </div>
    </section>

    <!-- kleiner Hinweis auf die Croissant-Einladung -->
    <aside class="k-croissant container--text" aria-label="The Boutique Croissant">
      <CroissantArt mini class="k-croissant__art" />
      <p class="k-croissant__text">{k.croissant}</p>
      <a class="k-croissant__link" href="/das-croissant-prinzip/">{k.croissantCta} <span aria-hidden="true">→</span></a>
    </aside>
  </main>

  <!-- Runde Einladung → Anfang der Croissant-Seite; ausgeblendet im Einstieg und beim Croissant-Hinweis unten -->
  <StickyInvite href="/das-croissant-prinzip/" label={croissantTeaser.sticky.label} meta={croissantTeaser.sticky.meta} hideNear={['.k-hero', '.k-croissant']} />

  <Footer contact={false} />
</Base>

<script>
  // Video erst laden, wenn es in die Nähe des Viewports kommt
  const video = document.querySelector<HTMLVideoElement>('.k-video');
  if (video) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    new IntersectionObserver(
      ([entry], obs) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        video.src = video.dataset.src ?? '';
        if (reduced) {
          video.controls = true;
          video.preload = 'metadata';
        } else {
          video.autoplay = true;
          video.play().catch(() => (video.controls = true));
        }
      },
      { rootMargin: '400px' },
    ).observe(video);
  }
</script>

<style>
  /* ---------- Kopf (wie Unterseiten) ---------- */
  .k-head {
    --c-ink-hero: var(--c-ink);
    padding-bottom: 1rem;
    text-align: center;
  }
  .k:focus {
    outline: none;
  }

  /* ---------- Einstieg ---------- */
  .k-hero {
    padding-top: 0;
    text-align: center;
  }
  .k-eyebrow {
    font-size: 0.8125rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .k-title {
    margin-top: 0.75rem;
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: clamp(1.9rem, 1.35rem + 2.2vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: var(--ls-display);
  }
  .k-title em {
    font-style: italic;
  }
  .k-lead {
    max-width: 40rem;
    margin: 1.5rem auto 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--c-ink-soft);
  }
  :global(:root[data-design='louder']) .k-title {
    font-family: var(--f-bold);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    letter-spacing: 1px;
    text-transform: lowercase;
    color: var(--c-heading);
  }
  :global(:root[data-design='louder']) .k-title em {
    font-style: normal;
  }

  /* ---------- Video + Kontaktwege ---------- */
  .k-intro {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    width: min(100% - 2 * var(--gutter), 62rem);
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
  }
  .k-video {
    display: block;
    width: min(100%, 22rem);
    margin-inline: auto;
    aspect-ratio: 442 / 516;
    object-fit: cover;
    border-radius: var(--radius);
    background: rgb(0 0 0 / 0.08);
  }
  .k-hello {
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    line-height: 1.25;
  }
  .k-names {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  :global(:root[data-design='louder']) .k-hello {
    font-family: var(--f-bold);
    font-style: normal;
    letter-spacing: 1px;
    text-transform: lowercase;
    color: var(--c-heading);
  }
  .k-list {
    display: grid;
    margin-top: 1.75rem;
    border-top: 1px solid color-mix(in srgb, var(--c-ink) 14%, transparent);
  }
  .k-way {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 14%, transparent);
    font-style: normal;
    text-decoration: none;
    color: inherit;
  }
  .k-way__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--c-ink) 25%, transparent);
    border-radius: 50%;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .k-way__icon svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .k-way__text {
    display: grid;
    flex: 1;
    gap: 0.1rem;
  }
  .k-way__label {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .k-way__value {
    font-size: 1.0625rem;
  }
  .k-way__arrow {
    opacity: 0.4;
    transition: translate 0.25s var(--ease), opacity 0.25s ease;
  }
  a.k-way:hover .k-way__icon,
  a.k-way:focus-visible .k-way__icon {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-bg);
  }
  a.k-way:hover .k-way__arrow,
  a.k-way:focus-visible .k-way__arrow {
    opacity: 1;
    translate: 4px 0;
  }
  :global(:root[data-design='louder']) a.k-way:hover .k-way__icon,
  :global(:root[data-design='louder']) a.k-way:focus-visible .k-way__icon {
    background: #000;
    border-color: #000;
    color: var(--c-accent);
  }
  @media (min-width: 48rem) {
    .k-intro {
      grid-template-columns: 1fr 1.1fr;
    }
    .k-video {
      width: 100%;
    }
  }

  /* ---------- Formular ---------- */
  .k-form {
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter) 0;
  }
  .k-form__panel {
    width: min(100%, 44rem);
    margin-inline: auto;
  }
  .k-form__title {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: var(--fs-h2-lg);
    letter-spacing: var(--ls-display);
    text-align: center;
  }
  .k-form__text {
    margin-top: 0.5rem;
    text-align: center;
    color: var(--c-ink-soft);
  }
  :global(:root[data-design='louder']) .k-form__title {
    font-family: var(--f-bold);
    font-size: var(--fs-h2);
    letter-spacing: 2px;
    text-transform: lowercase;
    color: var(--c-heading);
  }

  /* ---------- Croissant-Hinweis ---------- */
  .k-croissant {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    padding: clamp(3.5rem, 8vw, 5.5rem) 0 clamp(3.5rem, 8vw, 5rem);
    text-align: center;
  }
  .k-croissant :global(.k-croissant__art) {
    width: 3.25rem;
    --croissant-stroke: 1.2;
    margin-bottom: 0.5rem;
    color: var(--c-ink);
  }
  .k-croissant__text {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.25rem;
  }
  .k-croissant__link {
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
    font-size: 0.8125rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .k-croissant__link span {
    display: inline-block;
    transition: translate 0.25s var(--ease);
  }
  .k-croissant__link:hover span {
    translate: 4px 0;
  }
  :global(:root[data-design='louder']) .k-croissant__text {
    font-family: var(--f-bold);
    font-style: normal;
    letter-spacing: 1px;
    text-transform: lowercase;
    color: var(--c-heading);
  }
</style>
