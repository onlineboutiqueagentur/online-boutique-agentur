---
/**
 * /entdecken – Landingpage für Social-Media-Werbung (Ziel: neue Kundinnen und Kunden).
 * Aufbau: Einstieg · „Kommt dir das bekannt vor?“ · Lösung · drei Themenwelten ·
 * Croissant-Prinzip (Button zur Croissant-Seite).
 * Gestaltung mit den bestehenden Design-Elementen – funktioniert in beiden Designwelten.
 */
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import SectionHead from '../components/SectionHead.astro';
import CroissantArt from '../components/CroissantArt.astro';
import Footer from '../components/Footer.astro';
import { Picture, getImage } from 'astro:assets';
import { agency } from '../content/site';
import { entdecken as e, entdeckenImages as img, entdeckenSeo } from '../content/entdecken';

const f = e.invite.form;

// Feine Linien-Symbole für „Kommt dir das bekannt vor?“ (24er-Raster, Strichstärke wie die Croissant-Linien)
const icons: Record<string, string> = {
  website: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M3 9h18"/><circle cx="6" cy="6.75" r=".4"/><circle cx="8" cy="6.75" r=".4"/><path d="M7 13h6M7 16h4"/>',
  growth: '<path d="M12 20v-9"/><path d="M12 11c0-3.5 2.5-6 6.5-6 0 3.5-2.5 6-6.5 6Z"/><path d="M12 14c0-2.8-2-4.8-5.5-4.8 0 2.8 2 4.8 5.5 4.8Z"/><path d="M8 20h8"/>',
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/>',
  idea: '<path d="M9 17.5h6M10 20.5h4"/><path d="M12 3.5a6 6 0 0 0-3.6 10.8c.6.5 1 1.3 1 2.1v1.1h5.2v-1.1c0-.8.4-1.6 1-2.1A6 6 0 0 0 12 3.5Z"/>',
  compass: '<circle cx="12" cy="12" r="8.5"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z"/>',
};
const icon = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${icons[name]}</svg>`;

// Header-Bild: Querformat ab Tablet, Hochformat auf Smartphones (wie die Startseite)
const MOBILE = '(max-width: 47.99rem)';
const [mAvif, mWebp, dAvif, dWebp, dJpg] = await Promise.all([
  getImage({ src: img.hero.mobile, widths: [480, 750, 1080], format: 'avif' }),
  getImage({ src: img.hero.mobile, widths: [480, 750, 1080], format: 'webp' }),
  getImage({ src: img.hero.src, widths: [960, 1280, 1600, 1920], format: 'avif' }),
  getImage({ src: img.hero.src, widths: [960, 1280, 1600, 1920], format: 'webp' }),
  getImage({ src: img.hero.src, widths: [960, 1280, 1920], format: 'jpg', quality: 78 }),
]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${agency.url}/entdecken/#seite`,
  url: `${agency.url}/entdecken/`,
  name: entdeckenSeo.title,
  description: entdeckenSeo.description,
  inLanguage: 'de-AT',
  isPartOf: { '@id': `${agency.url}/#website` },
  about: { '@id': `${agency.url}/#organisation` },
};
---

<Base title={entdeckenSeo.title} description={entdeckenSeo.description} path={entdeckenSeo.path} extraJsonLd={jsonLd} noindex>
  <!-- 1 · Einstieg -->
  <header class="e-hero" id="top">
    <div class="e-hero__media">
      <picture>
        <source media={MOBILE} type="image/avif" srcset={mAvif.srcSet.attribute} sizes="100vw" />
        <source media={MOBILE} type="image/webp" srcset={mWebp.srcSet.attribute} sizes="100vw" />
        <source type="image/avif" srcset={dAvif.srcSet.attribute} sizes="100vw" />
        <source type="image/webp" srcset={dWebp.srcSet.attribute} sizes="100vw" />
        <img src={dJpg.src} srcset={dJpg.srcSet.attribute} sizes="100vw" width={img.hero.src.width} height={img.hero.src.height} alt={img.hero.alt} fetchpriority="high" loading="eager" decoding="async" />
      </picture>
    </div>

    <Navigation base="/" />

    <div class="e-hero__content parallax-hero">
      <a class="e-hero__brand" href="/">Online <em>Boutique</em> Agentur<sup aria-hidden="true">²</sup></a>
      <h1 class="e-hero__title">{e.hero.title}<br /><em>{e.hero.titleSecond}</em></h1>
      <p class="e-hero__sub">{e.hero.text}</p>
      <a class="btn e-hero__btn" href="#leistungen">{e.hero.cta}</a>
    </div>
  </header>

  <main id="inhalt" tabindex="-1" class="entdecken">
    <!-- 2 · Statement direkt nach dem Einstieg -->
    <section class="e-block" id="statement" aria-labelledby="e-love">
      <div class="v-line" aria-hidden="true"></div>
      <figure class="e-quote container--text reveal-up">
        <span class="e-quote__mark" aria-hidden="true">“</span>
        <blockquote>
          <h2 class="e-quote__title" id="e-love" set:html={e.love.title} />
          <p class="e-quote__text" set:html={e.love.textHtml} />
        </blockquote>
      </figure>
    </section>

    <!-- 2 · Kommt dir das bekannt vor? (ruhig, mit feinen Symbolen) -->
    <section class="e-block" id="bekannt" aria-labelledby="e-problems">
      <SectionHead id="e-problems" titleHtml={e.problems.title} textHtml={e.problems.text} />
      <ul role="list" class="e-calm container--text">
        {
          e.problems.items.map(([first, second, sym]) => (
            <li class="e-calm__item reveal-up">
              <span class="e-calm__icon" aria-hidden="true" set:html={icon(sym)} />
              <span>{first}</span>
              <em>{second}</em>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 4 · Drei Themenwelten: große Nummer, Bild und Text im Wechsel -->
    <section class="e-block e-block--big" id="leistungen" aria-labelledby="e-worlds">
      <SectionHead id="e-worlds" titleHtml={e.worldsTitle} textHtml={e.worldsText} />
      <ol role="list" class="e-rows container">
        {
          e.worlds.map((w, i) => (
            <li class:list={['e-row', { 'e-row--flip': i % 2 === 1 }]}>
              <figure class="e-row__media reveal">
                <Picture src={img.worlds[i].src} alt={img.worlds[i].alt} widths={[480, 720, 960]} sizes="(min-width: 48rem) 26rem, 90vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
              </figure>
              <div class="e-row__text reveal-up">
                <span class="e-row__no" aria-hidden="true">{w.no}</span>
                <h2 class="e-row__title">{w.title}</h2>
                <p>{w.text}</p>
                <ul role="list" class="e-row__tags">
                  {w.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </section>


    <!-- 3 · Die Lösung -->
    <section class="e-block" aria-labelledby="e-solution">
      <SectionHead id="e-solution" titleHtml={e.solution.title} />
      <div class="e-solution container">
        <figure class="e-solution__media reveal">
          <Picture src={img.team.src} alt={img.team.alt} widths={[640, 960, 1280]} sizes="(min-width: 48rem) 30rem, 90vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
        </figure>
        <div class="e-solution__text">
          {e.solution.paragraphs.map((p, i) => <p class:list={{ 'e-solution__first': i === 0 }} set:html={p} />)}
          <a class="btn btn--solid e-solution__btn" href={e.solution.ctaHref}>{e.solution.cta}</a>
          <a class="e-principle e-solution__link" href={e.solution.loveHref}>{e.solution.love} →</a>
        </div>
      </div>
    </section>


    <!-- 5 · Croissant-Prinzip -->
    <section class="e-final" aria-labelledby="e-croissant">
      <div class="v-line" aria-hidden="true"></div>
      <div class="container--text e-final__inner">
        <CroissantArt draw revealAt={0.7} class="e-final__art" label="Feine Linienzeichnung eines Croissants" />
        <h2 class="heading e-final__title" id="e-croissant" set:html={e.croissant.title} />
        <div class="e-final__text">
          {e.croissant.paragraphs.map((p) => <p set:html={p} />)}
        </div>
        <a class="btn btn--solid e-cta" href={e.croissant.href}>
          <CroissantArt mini class="e-cta__icon" />
          {e.croissant.cta}
        </a>
        <a class="e-principle" href={e.croissant.principleHref}>{e.croissant.principle} →</a>
      </div>
    </section>
    <!-- 6 · Kontaktanfrage: Einladung zum virtuellen Frühstück -->
    <section class="e-invite" id="anfrage" aria-labelledby="e-invite">
      <div class="v-line" aria-hidden="true"></div>
      <div class="container--text e-invite__head">
        <figure class="e-team reveal">
          <Picture src={img.invite.src} alt={img.invite.alt} widths={[520, 1040]} sizes="16rem" formats={['avif', 'webp']} loading="lazy" decoding="async" />
        </figure>
        <h2 class="heading" id="e-invite">{e.invite.title}</h2>
        <p class="lead-text">{e.invite.text}</p>
      </div>

      <form class="form e-form" action="/api/contact" method="post" novalidate data-contact-form>
        <div class="e-form__fields" data-form-fields>
          <p class="e-form__intro"><strong>{f.title}</strong> {f.text}</p>
          <div class="form__field">
            <label for="e-name">{f.fields.name} <span aria-hidden="true">*</span></label>
            <input id="e-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="e-name-err" />
            <p class="form__error" id="e-name-err" hidden>Verrätst du uns deinen Namen?</p>
          </div>
          <div class="form__field">
            <label for="e-company">{f.fields.company} <span aria-hidden="true">*</span></label>
            <input id="e-company" name="company" type="text" autocomplete="organization" required maxlength="160" aria-describedby="e-company-err" />
            <p class="form__error" id="e-company-err" hidden>Wie heißt deine Marke oder dein Unternehmen?</p>
          </div>
          <div class="form__field">
            <label for="e-email">{f.fields.email} <span aria-hidden="true">*</span></label>
            <input id="e-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="e-email-err" />
            <p class="form__error" id="e-email-err" hidden>Bitte gib eine gültige E-Mail-Adresse an.</p>
          </div>
          <div class="form__field">
            <label for="e-phone">{f.fields.phone}</label>
            <input id="e-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
          </div>
          <div class="form__field">
            <label for="e-when">{f.fields.when}</label>
            <input id="e-when" name="when" type="text" maxlength="200" placeholder={f.fields.whenPlaceholder} />
          </div>
          <div class="form__field">
            <label for="e-message">{f.fields.message}</label>
            <textarea id="e-message" name="message" rows="3" maxlength="5000"></textarea>
          </div>

          <div class="form__hp" aria-hidden="true">
            <label for="e-website">Website</label>
            <input id="e-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="ts" value="" data-ts />
          <input type="hidden" name="quelle" value="croissant" />
          <input type="hidden" name="format" value="virtuell" />
          <input type="hidden" name="design" value="" data-design-field />

          <p class="form__privacy">Mit dem Absenden werden deine Angaben zur Bearbeitung deiner Anfrage verwendet. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
          <div class="form__actions">
            <button class="btn btn--solid e-cta" type="submit" data-label={f.submit} data-sending={f.sending}>{f.submit}</button>
          </div>
          <p class="e-form__meta">{e.invite.meta}</p>
        </div>

        <div class="form__status" role="status" aria-live="polite" tabindex="-1" data-form-status>
          <p class="form__msg form__msg--ok e-form__ok" hidden data-ok>{f.success}</p>
          <p class="form__msg form__msg--err" hidden data-err>{f.error}</p>
        </div>
      </form>
    </section>
  </main>

  <Footer contact={false} />

  <!-- Mobil: Einladung am unteren Rand wie auf der Croissant-Seite – erscheint nach dem Einstieg, verschwindet beim Formular -->
  <a class="e-sticky btn btn--solid" href="#anfrage" data-sticky-cta>
    <CroissantArt mini class="e-sticky__icon" />
    {f.submit}
  </a>
</Base>

<script>
  import '../scripts/contact-form';

  // Einladung am unteren Rand: sichtbar, sobald der Einstieg weg ist – aber nicht beim Formular selbst
  const sticky = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector('.e-hero');
  const invite = document.getElementById('anfrage');
  if (sticky && hero && invite && 'IntersectionObserver' in window) {
    let heroVisible = true;
    let inviteVisible = false;
    const update = () => sticky.classList.toggle('is-visible', !heroVisible && !inviteVisible);
    new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting;
      update();
    }).observe(hero);
    new IntersectionObserver(([entry]) => {
      inviteVisible = entry.isIntersecting;
      update();
    }).observe(invite);
  }
</script>

<style>
  .entdecken:focus {
    outline: none;
  }
  .e-block {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .entdecken :global(.croissant-art) {
    color: var(--c-ink);
  }
  :global(:root[data-design='louder']) .entdecken :global(.croissant-art) {
    color: #000;
    --croissant-fill: var(--c-accent);
  }
  .reveal-up {
    transition-delay: calc(var(--i, 0) * 0.12s);
  }

  /* ---------- 1 · Einstieg (wie der Header der Startseite) ---------- */
  .e-hero {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: max(37.5rem, 100svh);
    color: #fff;
    background: #ddd8d1;
    isolation: isolate;
    clip-path: inset(0);
  }
  .e-hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .e-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  @media (min-width: 64rem) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .e-hero__media {
      position: fixed;
      height: 100vh;
    }
  }
  .e-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.15) 60%, rgb(0 0 0 / 0.1));
  }
  .e-hero :global(.nav__list),
  .e-hero :global(.nav-toggle),
  .e-hero__content {
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.25), 0 0 24px rgb(0 0 0 / 0.28);
  }
  .e-hero :global(.nav__list a),
  .e-hero :global(.nav-toggle) {
    color: #fff;
  }
  .e-hero__content {
    align-self: end;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    width: min(100% - 2 * var(--gutter), 50rem);
    margin-inline: auto;
    padding-bottom: clamp(4rem, 14vh, 9rem);
    text-align: center;
  }
  .e-hero__brand {
    font-family: var(--f-display);
    font-size: 1.05rem;
    text-decoration: none;
  }
  .e-hero__title {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: var(--fs-hero);
    line-height: 1.12;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  .e-hero__title em {
    font-style: italic;
  }
  .e-hero__sub {
    max-width: 38rem;
    font-weight: var(--w-regular);
    font-size: var(--fs-hero-sub);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .e-hero__btn {
    margin-top: 0.5rem;
    border-color: #fff;
    color: #fff;
    text-shadow: none;
  }
  .e-hero__btn:hover {
    background: #fff;
    color: #000;
  }
  :global(:root[data-design='louder']) .e-hero__brand {
    font-family: var(--f-bold);
    color: var(--c-accent);
    font-size: 1.5rem;
    letter-spacing: 1px;
  }
  :global(:root[data-design='louder']) .e-hero__brand em,
  :global(:root[data-design='louder']) .e-hero__title em {
    font-style: normal;
  }
  :global(:root[data-design='louder']) .e-hero__title {
    font-family: var(--f-bold);
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.75rem);
    letter-spacing: 1px;
    line-height: 1.05;
    text-transform: lowercase;
  }
  :global(:root[data-design='louder']) .e-hero__title em {
    color: var(--c-accent);
  }
  :global(:root[data-design='louder']) .e-hero__btn {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: #000;
  }
  :global(:root[data-design='louder']) .e-hero__btn:hover {
    background: #000;
    border-color: #000;
    color: var(--c-accent);
  }

  /* ---------- 2 · Kommt dir das bekannt vor? ---------- */
  /* ---------- 2 · Liste ---------- */
  .e-calm {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    text-align: center;
  }
  .e-calm__item {
    display: grid;
    gap: 0.2rem;
  }
  .e-calm__item span {
    font-size: 1rem;
  }
  .e-calm__icon {
    justify-self: center;
    margin-bottom: 0.6rem;
  }
  .e-calm__icon :global(svg) {
    display: block;
    width: 1.9rem;
  }
  :global(:root[data-design='louder']) .e-calm__icon {
    color: #000;
  }
  .e-calm__item em {
    font-family: var(--f-display);
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.4;
    text-wrap: balance;
  }
  :global(:root[data-design='louder']) .e-calm__item em {
    font-family: var(--f-bold);
    font-style: normal;
    text-transform: lowercase;
    letter-spacing: 1px;
  }

  /* ---------- 3 · Lösung ---------- */
  .e-solution {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .e-solution__media :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  .e-solution__text {
    display: grid;
    gap: 1rem;
    font-size: 1.0625rem;
  }
  .e-solution__text :global(b) {
    font-weight: var(--w-bold);
  }
  .e-solution__btn {
    justify-self: start;
    margin-top: 0.75rem;
  }
  .e-solution__link {
    justify-self: start;
    margin-top: 0.25rem;
  }
  .e-solution__first {
    font-family: var(--f-display);
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.4;
  }
  @media (min-width: 48rem) {
    .e-solution {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 6vw, 5rem);
    }
  }
  :global(:root[data-design='louder']) .e-solution__first {
    font-family: var(--f-bold);
    text-transform: lowercase;
    letter-spacing: 1px;
  }

  /* ---------- Einladung am unteren Rand (wie auf der Croissant-Seite, nur mobil) ---------- */
  .e-sticky {
    position: fixed;
    white-space: nowrap;
    left: 50%;
    bottom: 1rem;
    z-index: 30;
    gap: 0.6rem;
    translate: -50% 140%;
    opacity: 0;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
    transition:
      translate 0.4s var(--ease),
      opacity 0.3s var(--ease);
  }
  .e-sticky :global(.e-sticky__icon) {
    width: 1.5rem;
    color: inherit;
    --croissant-fill: transparent;
  }
  .e-sticky.is-visible {
    translate: -50% 0;
    opacity: 1;
  }
  @media (min-width: 48rem) {
    .e-sticky {
      display: none;
    }
  }

  /* ---------- 4 · Themenwelten ---------- */
  /* „für deine eigene Marke.“ bleibt in einer Zeile */
  .e-block--big :global(.section-head__title em) {
    white-space: nowrap;
  }

  .e-rows {
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .e-row {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  .e-row__media {
    overflow: hidden;
    border-radius: var(--radius);
  }
  .e-row__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .e-row__text {
    display: grid;
    gap: 1rem;
    font-size: 1.0625rem;
  }
  .e-row__no {
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    line-height: 0.9;
    color: var(--c-ink);
  }
  .e-row__title {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1.25;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  .e-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .e-row__tags li {
    padding: 0.35rem 0.9rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: var(--w-regular);
  }
  @media (min-width: 48rem) {
    .e-row {
      grid-template-columns: 1fr 1.1fr;
      gap: clamp(2.5rem, 6vw, 5rem);
    }
    .e-row--flip {
