---
/**
 * /angebot/<kunde>/ – persönliche Angebotsseite „The Smart Website Concept“.
 * Angebote aus dem CRM: functions/angebot/[[path]].ts füllt die Vorlage /angebot/_vorlage/ mit den Daten
 * aus dem Speicher (Stellen mit data-a="…"). Feste Angebote (z. B. „beispiel“) stehen in src/content/angebot.ts.
 * Nicht indexiert (noindex + X-Robots-Tag in public/_headers), nicht in der Sitemap.
 * „Als PDF speichern“ nutzt den Druckdialog des Browsers – das Druck-Layout steht unten bei @media print.
 * Gestaltung mit den bestehenden Design-Elementen – funktioniert in beiden Designwelten.
 */
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Footer from '../../components/Footer.astro';
import { Picture } from 'astro:assets';
import { agency, intro } from '../../content/site';
import { angebot as t, angebote, angebotImages as img, preise as standardPreise, euro, type Angebot } from '../../content/angebot';
import { datum } from '../../../lib/angebot-daten';

export function getStaticPaths() {
  /** Platzhalter für die Vorlage – die Function ersetzt alle markierten Stellen. */
  const vorlage: Angebot = {
    slug: '_vorlage',
    anrede: 'Vorname',
    firma: 'Firma',
    name: 'Name',
    email: 'mail@example.at',
    zusatzSeiten: 1,
    zusatzSeitenNotiz: 'Notiz',
    erstellt: '2026-01-01',
    gueltigBis: '2026-01-31',
  };
  return [...angebote, vorlage].map((a) => ({ params: { kunde: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: Angebot };
const p = { ...standardPreise, ...a.preise };
const zusatzSumme = a.zusatzSeiten * p.zusatzSeite;
const gesamt = p.onepager + zusatzSumme;
const empfohlen = new Set(a.empfohlen ?? []);
// Überschrift im Team-Abschnitt: „Wir lieben/leben Boutique Agentur.“ wie auf der Startseite (Schreibmaschine)
const tw = intro.typewriter;
const twSteps = tw.words.map((word) => ({ word }));

const title = `Dein Angebot, ${a.anrede} | Online Boutique Agentur`;
const description = `The Smart Website Concept für ${a.firma} – dein persönliches Website-Angebot von Pia & Nina.`;
const path = `/angebot/${a.slug}/`;
---

<Base title={title} description={description} path={path} noindex>
  <header class="a-head" id="top">
    <a class="a-head__brand" href="/">Online <em>Boutique</em> Agentur<sup aria-hidden="true">²</sup></a>
    <button type="button" class="btn btn--sm a-head__pdf" data-print>{t.final.pdf}</button>
  </header>

  <main id="inhalt" tabindex="-1" class="angebot">
    <!-- 1 · Persönlicher Einstieg -->
    <section class="a-hero container" aria-labelledby="a-title">
      <div class="a-hero__text">
        <p class="a-eyebrow">{t.eyebrow}. {t.tagline}<br />für <span data-a="firma">{a.firma}</span></p>
        <h1 class="a-title" id="a-title">{t.hero.title}<br /><em>{t.hero.titleSecond}</em></h1>
        <p class="a-greeting">
          <span class="a-greeting__hello" data-a="hallo">Hallo {a.anrede},</span>
          <span data-a="gruss" data-standard={t.gruss} set:html={a.grussHtml || t.gruss} />
        </p>
        <p class="a-signature">{t.final.signature}</p>
        <p class="a-meta" data-a="meta">Erstellt am {datum(a.erstellt)} · {t.final.gueltig(datum(a.gueltigBis))}</p>
      </div>
      <figure class="a-hero__media reveal">
        <Picture src={img.hero.src} alt={img.hero.alt} widths={[480, 800, 1100]} sizes="(min-width: 48rem) 30rem, 90vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" decoding="async" />
      </figure>
    </section>

    <!-- 2 · Warum ein Onepager -->
    <section class="a-block" aria-labelledby="a-why">
      <SectionHead id="a-why" titleHtml={t.why.title} />
      <div class="a-story container--text">
        {t.why.paragraphs.map((html) => <p set:html={html} />)}
      </div>
      <div class="a-facts container">
        {
          t.why.facts.map(([q, text], i) => (
            <div class="a-card reveal-up" style={`--i:${i}`}>
              <h3 class="a-card__title">{q}</h3>
              <p>{text}</p>
            </div>
          ))
        }
      </div>
      <blockquote class="a-quote reveal-up"><p>„{t.why.quote}“</p></blockquote>
    </section>

    <!-- 3 · Ablauf -->
    <section class="a-block" aria-labelledby="a-steps">
      <SectionHead id="a-steps" titleHtml={t.ablauf.title} textHtml={t.ablauf.text} />
      <ol role="list" class="a-steps container--text">
        {
          t.ablauf.steps.map(([name, text], i) => (
            <li class="a-step reveal-up">
              <span class="a-step__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="a-step__title">{name}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 4 · Aufbau -->
    <section class="a-block" aria-labelledby="a-parts">
      <SectionHead id="a-parts" titleHtml={t.struktur.title} />
      <ul role="list" class="a-parts container">
        {
          t.struktur.parts.map(([name, text], i) => (
            <li class="a-part reveal-up" style={`--i:${i}`}>
              <span class="a-part__name">{name}</span>
              <span class="a-part__text">{text}</span>
            </li>
          ))
        }
      </ul>
      <div class="a-grow container--text reveal-up">
        <p class="a-grow__title">{t.struktur.grow.title}</p>
        <p>{t.struktur.grow.text}</p>
        <p class="a-grow__price" data-a="grow">{t.preis.grow(euro(p.zusatzSeite))}</p>
      </div>
      <blockquote class="a-quote reveal-up"><p>„{t.struktur.quote}“</p></blockquote>
    </section>

    <!-- 5 · Technik -->
    <section class="a-block" aria-labelledby="a-tech">
      <SectionHead id="a-tech" titleHtml={t.technik.title} />
      <div class="a-story container--text">
        {t.technik.paragraphs.map((html) => <p set:html={html} />)}
        <p><b>{t.technik.domain.title}</b> {t.technik.domain.text}</p>
      </div>
    </section>

    <!-- 6 · Preis -->
    <section class="a-block a-price-block" id="preis" aria-labelledby="a-price">
      <SectionHead id="a-price" titleHtml={t.preis.title} />
      <div class="a-price container--text">
        <div class="a-price__card reveal-up">
          <dl class="a-price__lines">
            <div class="a-price__line">
              <dt>{t.preis.onepager}</dt>
              <dd data-a="onepager">{euro(p.onepager)}</dd>
            </div>
            {
              a.zusatzSeiten > 0 && (
                <div class="a-price__line" data-a="zusatz">
                  <dt>
                    <span data-a="zusatz-text">{t.preis.zusatz(a.zusatzSeiten)}</span>
                    {a.zusatzSeitenNotiz && <span class="a-price__note" data-a="zusatz-notiz">{a.zusatzSeitenNotiz}</span>}
                    <span class="a-price__note" data-a="zusatz-rechnung">{a.zusatzSeiten} × {euro(p.zusatzSeite)}</span>
                  </dt>
                  <dd data-a="zusatz-summe">{euro(zusatzSumme)}</dd>
                </div>
              )
            }
            <div class="a-price__line a-price__line--total">
              <dt>{t.preis.gesamt}</dt>
              <dd data-a="gesamt">{euro(gesamt)}</dd>
            </div>
          </dl>
          <p class="a-price__tax">{t.preis.steuer}</p>
        </div>

        <div class="a-price__info">
          <div class="reveal-up">
            <h3 class="a-card__title">{t.preis.timing.title}</h3>
            <p>{t.preis.timing.text}</p>
          </div>
          <div class="reveal-up">
            <h3 class="a-card__title">{t.preis.laufend.title}</h3>
            <p><b>{t.preis.laufend.betreuung} · <span data-a="betreuung">{euro(p.betreuungMonat)}</span> / Monat</b><br />{t.preis.laufend.betreuungText}</p>
            <p><b>{t.preis.laufend.domain}</b><br />{t.preis.laufend.domainText}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7 · Toppings -->
    <section class="a-block" aria-labelledby="a-toppings">
      <SectionHead id="a-toppings" titleHtml={t.toppings.title} textHtml={t.toppings.text} />
      <ul role="list" class="a-toppings container" data-tipp={t.toppings.empfohlen}>
        {
          t.toppings.items.map((item, i) => (
            <li class:list={['a-card a-topping reveal-up', { 'is-empfohlen': empfohlen.has(item.nr) }]} style={`--i:${i % 3}`} data-topping={item.nr}>
              {empfohlen.has(item.nr) && <span class="a-topping__tip">{t.toppings.empfohlen}</span>}
              <span class="a-topping__nr">#{item.nr}</span>
              <h3 class="a-card__title">{item.title}</h3>
              <p>{item.text}</p>
              <p class="a-topping__price">{item.preis}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 8 · Das sind wir -->
    <section class="a-block" aria-labelledby="a-team">
      <div class="v-line" aria-hidden="true"></div>
      <div class="a-team container">
        <figure class="a-team__media reveal">
          <Picture src={img.team.src} alt={img.team.alt} widths={[500, 800, 1100]} sizes="(min-width: 48rem) 32rem, 90vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
        </figure>
        <div class="a-team__text">
          <p class="a-eyebrow">{t.team.eyebrow}</p>
          <h2 class="heading a-h2 a-team__title" id="a-team">
            <span class="sr-only">{intro.headingStatic}</span>
            <span aria-hidden="true" data-typewriter={JSON.stringify(twSteps)}>
              {tw.before} <span data-tw-word>{tw.words[1]}</span><span class="cursor">|</span>{tw.after}
            </span>
          </h2>
          {t.team.paragraphs.map((html) => <p set:html={html} />)}
          <blockquote class="a-team__quote"><p>„{t.team.quote}“</p></blockquote>
        </div>
      </div>
    </section>

    <!-- 9 · Abschluss + Angebot annehmen -->
    <section class="a-final" id="annehmen" aria-labelledby="a-final">
      <div class="v-line" aria-hidden="true"></div>
      <blockquote class="a-quote a-quote--final reveal-up"><p>„{t.final.quote}“</p></blockquote>
      <div class="container--text a-final__head">
        <h2 class="heading" id="a-final" set:html={t.final.title} />
        <p class="lead-text">{t.final.text}</p>
      </div>

      <form class="form a-form" action="/api/contact" method="post" novalidate data-contact-form>
        <div class="a-form__fields" data-form-fields>
          <input type="hidden" name="name" value={a.name} data-a="name" />
          <input type="hidden" name="company" value={a.firma} data-a="company" />
          <input type="hidden" name="email" value={a.email} data-a="email" />
          <input type="hidden" name="message" value={`${t.eyebrow} · ${euro(gesamt)} · ${a.zusatzSeiten} Zusatzseite(n)`} data-a="message" />
          <div class="form__hp" aria-hidden="true">
            <label for="a-website">Website</label>
            <input id="a-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="ts" value="" data-ts />
          <input type="hidden" name="quelle" value="angebot" />
          <input type="hidden" name="angebot" value={a.slug} data-a="slug" />
          <input type="hidden" name="design" value="" data-design-field />
          <div class="form__actions a-form__actions">
            <button class="btn btn--solid a-form__btn" type="submit" data-label={t.final.form.submit} data-sending={t.final.form.sending}>{t.final.form.submit}</button>
          </div>
          <p class="a-form__note" data-a="note">{t.eyebrow} · {euro(gesamt)}</p>
        </div>

        <div class="form__status" role="status" aria-live="polite" tabindex="-1" data-form-status>
          <p class="form__msg form__msg--ok a-form__ok" hidden data-ok>{t.final.form.success}</p>
          <p class="form__msg form__msg--err" hidden data-err>{t.final.form.error}</p>
        </div>
      </form>

      <p class="a-direct">
        {t.final.alternative}
        <a href={agency.whatsapp} target="_blank" rel="noopener">WhatsApp</a> ·
        <a href={`tel:${agency.phoneE164}`}>{agency.phone}</a> ·
        <a href={`mailto:${agency.email}`}>{agency.email}</a>
      </p>
      <p class="a-meta a-final__valid" data-a="gueltig">{t.final.gueltig(datum(a.gueltigBis))}</p>

      <!-- Nur im PDF: Kontakt statt Formular -->
      <div class="a-print-contact">
        <p><b>{t.final.form.title}?</b> Antworte einfach auf unsere Mail oder melde dich direkt:</p>
        <p>{agency.email} · {agency.phone}</p>
        <p data-a="online">Online: {agency.url.replace('https://', '')}{path}</p>
      </div>
    </section>
  </main>

  <Footer contact={false} />

  <!-- Mobil: Annehmen-Button am unteren Rand – erscheint nach dem Einstieg, verschwindet beim Formular -->
  <a class="a-sticky btn btn--solid" href="#annehmen" data-sticky-cta>{t.final.form.title}</a>
</Base>

<script>
  import '../../scripts/contact-form';
  import '../../scripts/typewriter';

  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));

  const sticky = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector('.a-hero');
  const accept = document.getElementById('annehmen');
  if (sticky && hero && accept) {
    let heroVisible = true;
    let acceptVisible = false;
    const update = () => sticky.classList.toggle('is-visible', !heroVisible && !acceptVisible);
    new IntersectionObserver(([e]) => {
      heroVisible = e.isIntersecting;
      update();
    }).observe(hero);
    new IntersectionObserver(([e]) => {
      acceptVisible = e.isIntersecting;
      update();
    }).observe(accept);
  }
</script>

<style>
  /* ---------- Kopf ---------- */
  .a-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100% - 2 * var(--gutter), var(--container));
    margin: 0 auto;
    padding: 1.25rem 0;
  }
  .a-head__pdf {
    flex: none;
    white-space: nowrap;
  }
  .a-head__brand {
    font-family: var(--f-display);
    font-size: 1.25rem;
    text-decoration: none;
  }
  :global(:root[data-design='louder']) .a-head__brand {
    font-family: var(--f-bold);
    font-size: 1.6rem;
    letter-spacing: 1px;
    color: var(--c-accent);
  }
  :global(:root[data-design='louder']) .a-head__brand em {
    font-style: normal;
  }

  /* ---------- Bausteine ---------- */
  .a-eyebrow {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--c-ink-soft);
  }
  :global(:root[data-design='louder']) .a-eyebrow {
    font-family: var(--f-bold);
    font-style: normal;
    text-transform: lowercase;
    letter-spacing: 1px;
    color: #000;
  }
  .a-block {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .a-meta {
    font-size: 0.8125rem;
    color: var(--c-ink-soft);
  }
  .a-story {
    display: grid;
    gap: 0.9rem;
    max-width: 38rem;
    margin-top: 1.25rem;
    text-align: center;
    text-wrap: pretty;
  }
  .a-card {
    padding: 1.75rem;
    background: var(--c-card);
    border-radius: var(--radius);
    transition-delay: calc(var(--i, 0) * 90ms);
  }
  .a-card__title {
    margin-bottom: 0.5rem;
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  :global(:root[data-design='louder']) .a-card__title {
    font-family: var(--f-bold);
    letter-spacing: 1px;
    text-transform: lowercase;
    font-size: 1.375rem;
  }
  .a-quote {
    width: min(100% - 2 * var(--gutter), 40rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    text-align: center;
  }
  .a-quote p {
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    line-height: 1.25;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  :global(:root[data-design='louder']) .a-quote p {
    font-family: var(--f-bold);
    font-style: normal;
    letter-spacing: 1px;
    text-transform: lowercase;
    color: var(--c-heading);
  }
  .a-h2 {
    text-align: left;
  }
  :global(:root[data-design='louder']) .a-h2,
  :global(:root[data-design='louder']) .a-final .heading {
    font-family: var(--f-bold);
    font-size: var(--fs-h2);
    letter-spacing: 2px;
    text-transform: lowercase;
    color: var(--c-heading);
  }
  :global(:root[data-design='louder']) .a-h2 :global(em) {
    font-style: normal;
    color: #000;
  }

  /* ---------- 1 · Einstieg ---------- */
  .a-hero {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 0 clamp(3rem, 7vw, 5rem);
  }
  .a-hero__text {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .a-title {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3.125rem);
    line-height: 1.2;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  .a-title em {
    font-style: italic;
  }
  :global(:root[data-design='louder']) .a-title {
    font-family: var(--f-bold);
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.75rem);
    letter-spacing: 1px;
    line-height: 1.05;
    text-transform: lowercase;
    color: var(--c-heading);
  }
  :global(:root[data-design='louder']) .a-title em {
    font-style: normal;
    color: #000;
  }
  .a-greeting {
    max-width: 34rem;
    font-size: 1.0625rem;
  }
  .a-greeting__hello {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.25rem;
  }
  :global(:root[data-design='louder']) .a-greeting__hello {
    font-family: var(--f-bold);
    font-style: normal;
    letter-spacing: 1px;
  }
  .a-signature {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.125rem;
  }
  .a-hero__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (min-width: 48rem) {
    /* Bild links, Text rechts */
    .a-hero {
      grid-template-columns: 1fr 1.15fr;
      gap: clamp(2rem, 6vw, 5rem);
      min-height: calc(100svh - 6rem);
    }
    .a-hero__media {
      order: -1;
    }
  }

  /* ---------- 2 · Warum ---------- */
  .a-facts {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    width: min(100% - 2 * var(--gutter), 52rem);
  }
  @media (min-width: 40rem) {
    .a-facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---------- 3 · Ablauf ---------- */
  .a-steps {
    display: grid;
    gap: 0;
    max-width: 40rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .a-step {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid color-mix(in srgb, var(--c-ink) 18%, transparent);
  }
  .a-step:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 18%, transparent);
  }
  .a-step__nr {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--c-ink-soft);
  }
  .a-step__title {
    margin-bottom: 0.25rem;
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: 1.125rem;
  }
  :global(:root[data-design='louder']) .a-step__nr,
  :global(:root[data-design='louder']) .a-step__title {
    font-family: var(--f-bold);
    font-style: normal;
    letter-spacing: 1px;
    text-transform: lowercase;
  }
  :global(:root[data-design='louder']) .a-step__nr {
    color: var(--c-heading);
  }

  /* ---------- 4 · Aufbau ---------- */
  .a-parts {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    width: min(100% - 2 * var(--gutter), 52rem);
  }
  .a-part {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--c-ink) 14%, transparent);
    border-radius: 1rem;
    transition-delay: calc(var(--i, 0) * 70ms);
  }
  :global(:root[data-design='louder']) .a-part {
    border-radius: 0;
  }
  .a-part__name {
    font-family: var(--f-display);
    font-size: 1.125rem;
  }
  :global(:root[data-design='louder']) .a-part__name {
    font-family: var(--f-bold);
    letter-spacing: 1px;
    text-transform: lowercase;
  }
  .a-part__text {
    font-size: 0.875rem;
    color: var(--c-ink-soft);
  }
  @media (min-width: 40rem) {
    .a-parts {
      grid-template-columns: repeat(2, 1fr);
    }
