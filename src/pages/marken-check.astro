---
/**
 * /marken-check – „Du darfst in deine Marke verliebt sein.“
 * Selbst-Check für Einzelunternehmer:innen (Mobile First, etwa 2 Minuten):
 * Einstieg → „Bevor wir starten“: Wunschgefühl (1–2) → 10 Fragen mit Croissant-Skala → Ergebnis mit Auswertung je Bereich.
 *
 * - Texte und Fragen: src/content/markencheck.ts
 * - Auswertung läuft komplett im Browser. Anonyme Statistik (wie weit, wo abgebrochen) geht an
 *   /api/marken-check – ohne Cookie, ohne IP, mit einer zufälligen id pro Durchlauf.
 *   Browser im „internen Modus“ (?intern=1 bzw. im Admin angemeldet) zählen nicht mit.
 * - Kontaktformular nach dem Ergebnis: /api/contact mit quelle=markencheck → Mail + /admin + CRM.
 */
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import CroissantArt from '../components/CroissantArt.astro';
import CroissantTeaser from '../components/CroissantTeaser.astro';
import { contact } from '../content/site';
import { markencheck as m, markencheckSeo } from '../content/markencheck';

const k = m.kontakt;
/** Das Wunschgefühl ist der Einstieg („Bevor wir starten“), gezählt werden nur die Croissant-Fragen */
const gesamtFragen = m.fragen.length;
// Feine Linien-Icons im Stil der Croissant-Zeichnung (Kontur in Tinte, Akzent in Orange)
const icons = {
  uhr: '<circle cx="16" cy="17" r="11" class="i-fill"/><circle cx="16" cy="17" r="11"/><path d="M16 11v6l4 3M13 3h6M16 3v3"/>',
  anonym: '<rect x="7" y="14" width="18" height="13" rx="3" class="i-fill"/><rect x="7" y="14" width="18" height="13" rx="3"/><path d="M11 14v-3a5 5 0 0 1 10 0v3M16 19v3"/>',
  sofort: '<path d="M18 3 7 18h8l-2 11 12-16h-8l1-10z" class="i-fill"/><path d="M18 3 7 18h8l-2 11 12-16h-8l1-10z"/>',
};
---

<Base title={markencheckSeo.title} description={markencheckSeo.description} path={markencheckSeo.path} noindex>
  <header class="mc-head">
    <Navigation base="/" designSwitch />
  </header>

  <main id="inhalt" tabindex="-1" class="mc">
    <div
      class="mc-check container--text"
      data-check
      data-config={JSON.stringify({ fragen: m.fragen, bereiche: m.bereiche, ergebnisse: m.ergebnisse, auswertung: m.auswertung })}
    >
      <noscript>
        <p class="mc-noscript">Der Marken-Check braucht JavaScript. Bitte aktiviere es in deinem Browser oder <a href="/kontakt/">schreib uns direkt</a>.</p>
      </noscript>

      <!-- Einstieg -->
      <section class="mc-screen mc-intro is-active" data-screen="intro" aria-labelledby="mc-titel">
        <CroissantArt mini class="mc-intro__croissant" />
        <p class="mc-eyebrow">{m.intro.eyebrow}</p>
        <h1 class="mc-titel" id="mc-titel" tabindex="-1">{m.intro.titel} <em>{m.intro.titelBetont}</em> {m.intro.titelEnde}</h1>
        <p class="mc-slogan">{m.intro.slogan}</p>
        <p class="mc-lead">{m.intro.text}</p>
        <ul role="list" class="mc-punkte">
          {
            m.intro.punkte.map((p) => (
              <li class="mc-punkt">
                <svg class="mc-punkt__icon" viewBox="0 0 32 32" aria-hidden="true" set:html={icons[p.icon as keyof typeof icons]} />
                <strong>{p.titel}</strong>
                <span>{p.text}</span>
              </li>
            ))
          }
        </ul>
        <button type="button" class="btn btn--solid mc-btn mc-btn--start" data-start>
          <span class="mc-btn__haupt">{m.intro.start} <span aria-hidden="true">→</span></span>
          <span class="mc-btn__unter">{m.intro.startUnter}</span>
        </button>
      </section>

      <!-- Wunschgefühl -->
      <section class="mc-screen mc-screen--frage" data-screen="gefuehl" aria-labelledby="mc-gefuehl" hidden>
        <div class="v-line mc-linie" aria-hidden="true"></div>
        <p class="mc-schritt">{m.gefuehl.vorab}</p>
        <h2 class="mc-frage" id="mc-gefuehl" tabindex="-1">{m.gefuehl.titel}</h2>
        <p class="mc-hinweis" id="mc-gefuehl-hinweis">{m.gefuehl.hinweis}</p>
        <ul role="list" class="mc-chips" aria-describedby="mc-gefuehl-hinweis">
          {
            m.gefuehl.optionen.map((g) => (
              <li>
                <button type="button" class="mc-chip" aria-pressed="false" data-gefuehl={g}>
                  {g}
                </button>
              </li>
            ))
          }
        </ul>
        <div class="mc-nav">
          <button type="button" class="mc-zurueck" data-zurueck>{m.navigation.zurueck}</button>
          <button type="button" class="btn btn--solid mc-btn" data-gefuehl-weiter disabled>{m.gefuehl.weiter}</button>
        </div>
      </section>

      <!-- Fragen -->
      {
        m.fragen.map((f, i) => (
          <section class="mc-screen mc-screen--frage" data-screen={`frage-${i}`} aria-labelledby={`mc-f${i}`} hidden>
            <div class="mc-fortschritt" aria-hidden="true">
              <span style={`--p:${(i + 1) / gesamtFragen}`} />
            </div>
            <div class="v-line mc-linie" aria-hidden="true" />
            <p class="mc-schritt">
              {m.navigation.frage} {i + 1} {m.navigation.von} {gesamtFragen}
              <span class="mc-schritt__bereich">· {m.bereiche[f.bereich].name}</span>
            </p>
            <h2 class="mc-frage" id={`mc-f${i}`} tabindex="-1" data-text={f.text}>
              {f.text.replace('{gefuehl}', '…')}
            </h2>
            <div class="mc-skala" role="group" aria-labelledby={`mc-f${i}`}>
              <div class="mc-herzen">
                {[1, 2, 3, 4, 5].map((n) => (
                  <button type="button" class="mc-herz" data-wert={n} aria-pressed="false" aria-label={`${n} von 5 Croissants`}>
                    <CroissantArt mini />
                  </button>
                ))}
              </div>
              <div class="mc-skala__labels" aria-hidden="true">
                <span>{f.von}</span>
                <span>{f.bis}</span>
              </div>
            </div>
            <div class="mc-nav">
              <button type="button" class="mc-zurueck" data-zurueck>
                {m.navigation.zurueck}
              </button>
              <button type="button" class="btn btn--solid mc-btn" data-frage-weiter disabled>
                {i === m.fragen.length - 1 ? m.navigation.ergebnis : m.navigation.weiter}
              </button>
            </div>
          </section>
        ))
      }

      <!-- Ergebnis -->
      <section class="mc-screen mc-ergebnis" data-screen="ergebnis" aria-labelledby="mc-ergebnis" hidden>
        <p class="mc-symbol" aria-hidden="true" data-e-symbol>
          <CroissantArt mini /><CroissantArt mini /><CroissantArt mini />
        </p>
        <p class="mc-eyebrow">Dein Ergebnis</p>
        <h2 class="mc-titel" id="mc-ergebnis" tabindex="-1" data-e-titel></h2>
        <p class="mc-lead" data-e-text></p>

        <div class="mc-auswertung">
          <h3 class="mc-h3">{m.auswertung.titel}</h3>
          <p class="mc-gefuehl-tag" data-e-gefuehl></p>
          <ul role="list" class="mc-balken" data-e-balken></ul>
          <p class="mc-satz" data-e-staerke></p>
          <p class="mc-satz" data-e-potenzial></p>
        </div>

        <div class="mc-tipp">
          <h3 class="mc-h3">{m.auswertung.tippTitel}</h3>
          <p data-e-tipp></p>
        </div>

        <!-- Bonus: Website-Checkliste zum Abhaken, als PDF speicherbar (Druckansicht zeigt nur diesen Block) -->
        <section class="mc-bonus" aria-labelledby="mc-bonus-titel" data-bonus>
          <p class="mc-eyebrow">{m.bonus.eyebrow}</p>
          <h3 class="mc-h3" id="mc-bonus-titel">{m.bonus.titel}</h3>
          <p class="mc-bonus__text">{m.bonus.text}</p>
          <ul role="list" class="mc-bonus__liste">
            {
              m.bonus.punkte.map((p, i) => (
                <li>
                  <label class="mc-bonus__punkt">
                    <input type="checkbox" class="mc-bonus__box" data-bonus-box />
                    <span class="mc-bonus__haken" aria-hidden="true">
                      <CroissantArt mini />
                    </span>
                    <span>
                      <strong>
                        {i + 1}. {p.titel}
                      </strong>
                      <span class="mc-bonus__frage">{p.text}</span>
                    </span>
                  </label>
                </li>
              ))
            }
          </ul>
          <p class="mc-bonus__ok" data-bonus-ok hidden>{m.bonus.alleOk}</p>
          <div class="mc-bonus__aktion">
            <button type="button" class="btn mc-bonus__pdf" data-bonus-pdf>{m.bonus.pdf}</button>
            <span class="mc-bonus__hinweis">{m.bonus.pdfHinweis}</span>
          </div>
          <p class="mc-bonus__fuss">{m.bonus.fusszeile}</p>
        </section>

        <!-- Wer dahintersteht: Video von Nina und Pia (wie auf der Startseite), lädt erst beim Anzeigen -->
        <figure class="mc-video">
          <video class="mc-video__film" muted loop playsinline preload="none" data-src={contact.video.src} aria-label={contact.video.label}></video>
          <figcaption>{m.video.text}</figcaption>
        </figure>

        <!-- Teaser: Was ein Croissant mit deinem Auftritt zu tun hat → /das-croissant-prinzip/ -->
        <div class="mc-teaser">
          <CroissantTeaser />
        </div>

        <form class="form mc-form" action="/api/contact" method="post" novalidate data-contact-form data-check-form>
          <h3 class="heading mc-form__titel">{k.titel}</h3>
          <div class="mc-form__felder" data-form-fields>
            <p class="mc-form__text">{k.text}</p>
            <div class="form__field">
              <label for="mc-name">{k.felder.name} <span aria-hidden="true">*</span></label>
              <input id="mc-name" placeholder=" " name="name" type="text" autocomplete="given-name" required maxlength="120" aria-describedby="mc-name-err" />
              <p class="form__error" id="mc-name-err" hidden>Verrätst du uns deinen Namen?</p>
            </div>
            <div class="form__field">
              <label for="mc-email">{k.felder.email} <span aria-hidden="true">*</span></label>
              <input id="mc-email" placeholder=" " name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="mc-email-err" />
              <p class="form__error" id="mc-email-err" hidden>Bitte gib eine gültige E-Mail-Adresse an.</p>
            </div>
            <div class="form__field">
              <label for="mc-firma">{k.felder.firma}</label>
              <input id="mc-firma" placeholder=" " name="company" type="text" autocomplete="organization" maxlength="160" />
            </div>
            <div class="form__field">
              <label for="mc-webseite">{k.felder.webseite}</label>
              <input id="mc-webseite" placeholder=" " name="webseite" type="text" inputmode="url" autocomplete="url" maxlength="200" />
            </div>
            <div class="form__field">
              <label for="mc-nachricht">{k.felder.nachricht}</label>
              <textarea id="mc-nachricht" placeholder=" " name="message" rows="3" maxlength="5000"></textarea>
            </div>

            <div class="form__hp" aria-hidden="true">
              <label for="mc-website">Website</label>
              <input id="mc-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="ts" value="" data-ts />
            <input type="hidden" name="quelle" value="markencheck" />
            <input type="hidden" name="check" value="" data-check-feld />
            <input type="hidden" name="ergebnis" value="" data-ergebnis-feld />
            <input type="hidden" name="design" value="" data-design-field />

            <p class="form__privacy">
              Mit dem Absenden werden deine Angaben und dein Check-Ergebnis zur Bearbeitung deiner Anfrage verwendet. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.
            </p>
            <div class="form__actions">
              <button class="btn btn--solid mc-btn" type="submit" data-label={k.absenden} data-sending={k.sendet}>
                <span data-btn-text>{k.absenden}</span>
              </button>
            </div>
            <p class="mc-meta">{k.meta}</p>
          </div>
          <div class="form__status" role="status" aria-live="polite" tabindex="-1" data-form-status>
            <p class="form__msg form__msg--ok" hidden data-ok>{k.erfolg}</p>
            <p class="form__msg form__msg--err" hidden data-err>{k.fehler}</p>
          </div>
        </form>

        <p class="mc-nochmal"><button type="button" class="mc-zurueck" data-nochmal>{m.auswertung.nochmal}</button></p>
      </section>
    </div>
  </main>

  <!-- Footer ohne Kontaktblock: WhatsApp sitzt in der schwarzen Fußleiste -->
  <Footer contact={false} />
</Base>

<script>
  import '../scripts/contact-form';
  import { starteMarkencheck } from '../scripts/markencheck';

  const root = document.querySelector<HTMLElement>('[data-check]');
  if (root) starteMarkencheck(root);
</script>

<style>
  .mc-head {
    --c-ink-hero: var(--c-ink);
    padding-bottom: 1rem;
    text-align: center;
  }
  .mc {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .mc-check {
    max-width: 40rem;
  }
  .mc-noscript {
    padding: 1rem 0;
  }
  .mc-screen {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    min-height: min(36rem, calc(100svh - 10rem));
    padding-top: clamp(1rem, 4vw, 2.5rem);
  }
  .mc-screen[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mc-screen.is-active {
      animation: mc-ein 0.45s var(--ease);
    }
  }
  @keyframes mc-ein {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .mc-screen :is(h1, h2):focus {
    outline: none;
  }

  /* ---------- Typo ---------- */
  .mc-eyebrow,
  .mc-schritt {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--c-ink-soft);
  }
  .mc-schritt__bereich {
    font-style: normal;
    font-family: var(--f-body);
    font-size: 0.8125rem;
  }
  .mc-titel {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: var(--fs-hero);
    line-height: 1.15;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
    color: var(--c-heading);
  }
  .mc-titel em {
    font-style: italic;
  }
  /* Slogan als kleine, augenzwinkernde Antwort auf die Titelfrage */
  .mc-slogan {
    margin-top: -0.5rem;
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    color: var(--c-ink-soft);
  }
  .mc-frage {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    line-height: 1.3;
    text-wrap: balance;
    min-height: 4em;
  }
  .mc-lead {
    font-size: var(--fs-hero-sub);
    text-wrap: pretty;
  }
  .mc-hinweis,
  .mc-meta {
    font-size: 0.875rem;
    color: var(--c-ink-soft);
  }
  .mc-h3 {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }
  :global(:root[data-design='louder']) :is(.mc-titel, .mc-frage, .mc-h3) {
    font-family: var(--f-bold);
    text-transform: lowercase;
    letter-spacing: 0;
  }
  :global(:root[data-design='louder']) .mc-titel em {
    font-style: normal;
    color: #000;
  }

  /* ---------- Einstieg ---------- */
  .mc :global(.croissant-art) {
    color: var(--c-ink);
  }
  :global(:root[data-design='louder']) .mc :global(.croissant-art) {
    color: #000;
  }
  .mc :global(.mc-intro__croissant) {
    width: 4.5rem;
    --croissant-fill: var(--c-accent);
    --croissant-stroke: 1.4;
  }
  /* Das Croissant wippt sanft – wie auf der Croissant-Seite */
  @media (prefers-reduced-motion: no-preference) {
    .mc :global(.mc-intro__croissant) {
      animation: mc-wippen 3.2s ease-in-out infinite;
    }
  }
  @keyframes mc-wippen {
    0%,
    70%,
    100% {
      transform: none;
    }
    80% {
      transform: rotate(-10deg) scale(1.05);
    }
    90% {
      transform: rotate(6deg) scale(1.05);
    }
  }
  /* Drei Punkte ohne Kästchen: Icon im orangen Kreis, getrennt durch den feinen senkrechten Strich */
  .mc-punkte {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 0;
    margin: 0.75rem 0 1rem;
  }
  .mc-punkt {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.15rem;
    padding: 0.25rem 0.5rem;
    text-align: center;
  }
  .mc-punkt + .mc-punkt {
    border-left: 1px solid color-mix(in srgb, var(--c-ink) 45%, transparent);
  }
  .mc-punkt strong {
    font-family: var(--f-display);
    font-style: italic;
    font-weight: var(--w-regular);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    line-height: 1.2;
  }
  :global(:root[data-design='louder']) .mc-punkt strong {
    font-family: var(--f-bold);
    font-style: normal;
    text-transform: lowercase;
  }
  .mc-punkt span {
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.04em;
    color: var(--c-ink-soft);
  }
  .mc-punkt__icon {
    box-sizing: content-box;
    width: 1.35rem;
    padding: 0.65rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    background: var(--c-accent);
    fill: none;
    stroke: #000;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s var(--ease);
  }
  .mc-punkt__icon :global(.i-fill) {
    display: none;
  }
  :global(:root[data-design='louder']) .mc-punkt__icon {
    background: #000;
    stroke: var(--c-accent);
  }
  @media (hover: hover) {
    .mc-punkt:hover .mc-punkt__icon {
      transform: rotate(-8deg) scale(1.06);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .mc-punkt {
      animation: mc-ein 0.5s var(--ease) both;
    }
    .mc-punkt:nth-child(2) {
      animation-delay: 0.1s;
    }
    .mc-punkt:nth-child(3) {
      animation-delay: 0.2s;
    }
  }
  /* Start-Button mit Unterzeile „Sofort-Ergebnis · ohne Anmeldung“ */
  .mc-btn.mc-btn--start {
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 2rem;
    justify-self: stretch;
  }
  @media (min-width: 36rem) {
    .mc-btn.mc-btn--start {
      justify-self: start;
      min-width: 20rem;
    }
  }
  .mc-btn__haupt {
    font-size: 1rem;
  }
  .mc-btn__unter {
    font-size: 0.75rem;
    opacity: 0.8;
  }
  .mc-btn {
    justify-self: start;
    min-width: 12rem;
    font-size: 0.9375rem;
  }
  .mc-btn[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
  }
  /* Nach einem Tipp bleibt am Handy der Hover-Zustand am nächsten Button hängen: gesperrt immer gleich aussehen lassen */
  .mc-btn.btn--solid[disabled]:hover {
    background: var(--c-ink);
    color: var(--c-bg);
  }
  :root[data-design='louder'] .mc-btn.btn--solid[disabled]:hover {
    background: #000;
    color: var(--c-accent);
  }

  /* ---------- Wunschgefühl ---------- */
  .mc-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
  }
  .mc-chip {
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--c-ink);
    border-radius: 999px;
    background: transparent;
    color: var(--c-ink);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      background-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  .mc-chip[aria-pressed='true'] {
    background: var(--c-ink);
    color: var(--c-bg);
  }
  .mc-chip[aria-disabled='true'] {
    opacity: 0.4;
  }
  :global(:root[data-design='louder']) .mc-chip {
    border-radius: 0;
  }

  /* ---------- Fragen: zentriert, mit dem senkrechten Strich darüber ---------- */
  .mc-screen--frage {
    justify-items: center;
    text-align: center;
  }
  .mc-screen--frage .mc-fortschritt {
    justify-self: stretch;
  }
  .mc-linie {
    height: clamp(48px, 9vh, 90px);
    margin: 0.5rem auto 0;
  }
  .mc-screen--frage .mc-chips {
    justify-content: center;
  }
  .mc-screen--frage .mc-skala {
    width: 100%;
  }
  .mc-screen--frage .mc-nav {
    justify-self: stretch;
  }
  .mc-screen--frage .mc-skala__labels span:first-child {
    text-align: left;
  }
  .mc-fortschritt {
    height: 3px;
    background: color-mix(in srgb, var(--c-ink) 12%, transparent);
  }
  .mc-fortschritt span {
    display: block;
    height: 100%;
    width: calc(var(--p) * 100%);
    background: var(--c-ink);
    transition: width var(--t-med) var(--ease);
  }
  .mc-skala {
    display: grid;
    gap: 0.5rem;
    max-width: 24rem;
  }
  .mc-herzen {
    display: flex;
    justify-content: space-between;
    gap: 0.25rem;
  }
