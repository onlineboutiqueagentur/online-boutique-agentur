---
/**
 * /croissant – The Boutique Croissant
 * Eine kleine digitale Einladung (Mobile First). Zwei Einstiege:
 *  - über den QR-Code auf der Croissant-Verpackung (/croissant/?qr=1) → „Du hast ein Croissant bekommen.“
 *  - über Website, Google oder Social Media → „Noch kein Croissant bekommen?“
 * Beide landen beim gleichen CTA: der Frühstücks-Einladung (Formular unten, Versand über /api/contact).
 * Gestaltung mit den bestehenden Design-Elementen – funktioniert in beiden Designwelten.
 */
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import SectionHead from '../components/SectionHead.astro';
import ThemedPicture from '../components/ThemedPicture.astro';
import CroissantArt from '../components/CroissantArt.astro';
import Footer from '../components/Footer.astro';
import { agency, flowImages } from '../content/site';
import { Picture } from 'astro:assets';
import { croissant as c, croissantImages as img, croissantSeo } from '../content/croissant';

const { fields } = c.form;

// Strukturierte Daten: die Seite, die Agentur dahinter und das Angebot (kostenloses Kennenlerngespräch)
const orgId = `${agency.url}/#organisation`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${agency.url}/croissant/#seite`,
      url: `${agency.url}/croissant/`,
      name: croissantSeo.title,
      description: croissantSeo.description,
      inLanguage: 'de-AT',
      isPartOf: { '@id': `${agency.url}/#website` },
      about: { '@id': orgId },
    },
    {
      '@type': 'Service',
      name: 'Kennenlern-Frühstück – 30 Minuten über deine Marke',
      serviceType: 'Kostenloses Erstgespräch zu Webdesign, Branding, Content, SEO und Online Marketing',
      provider: {
        '@type': 'ProfessionalService',
        '@id': orgId,
        name: agency.name,
        url: `${agency.url}/`,
        address: { '@type': 'PostalAddress', addressLocality: agency.address.city, addressRegion: agency.address.region, addressCountry: agency.address.country },
        founder: [{ '@type': 'Person', name: 'Nina Altmanninger' }, { '@type': 'Person', givenName: 'Pia' }],
      },
      areaServed: agency.areaServed.map((name) => ({ '@type': 'Place', name })),
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', description: '30 Minuten, kostenlos, live oder virtuell' },
    },
  ],
};
---

<Base title={croissantSeo.title} description={croissantSeo.description} path={croissantSeo.path} extraJsonLd={jsonLd} noindex>
  <header class="c-head" id="top">
    <Navigation base="/" />
    <a class="c-head__brand" href="/">Online <em>Boutique</em> Agentur<sup aria-hidden="true">²</sup></a>
  </header>

  <!-- Einstieg per QR-Code erkennen, bevor der Hero gezeichnet wird (kein Flackern, kein Cookie) -->
  <script is:inline>
    (function () {
      try {
        var p = new URLSearchParams(location.search);
        if (p.has('qr')) {
          sessionStorage.setItem('oba-croissant', 'qr');
          p.delete('qr');
          var s = p.toString();
          history.replaceState(null, '', location.pathname + (s ? '?' + s : '') + location.hash);
        }
        if (sessionStorage.getItem('oba-croissant') === 'qr') document.documentElement.classList.add('croissant-qr');
      } catch (e) {}
    })();
  </script>

  <main id="inhalt" tabindex="-1" class="croissant">
    <!-- 2 · Einstieg: Warum ein Croissant … (Header mit vollflächigem Bild) -->
    <section class="c-why1" id="warum" aria-labelledby="c-why1">
      <div class="c-why1__media">
        <Picture src={img.cafe.src} alt="" widths={[img.cafe.src.width]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="container--text c-why1__inner parallax-hero">
        <h1 class="c-why1__title" id="c-why1">
          <span class="sr-only">{c.why1.titleText}</span>
          <span aria-hidden="true">
            {c.why1.titleBefore}
            <CroissantArt mini class="c-why1__icon" />
            {c.why1.titleAfter}
          </span>
        </h1>
      </div>
    </section>

    <!-- 3 · The sweet little Extra -->
    <section class="c-block" aria-labelledby="c-story">
      <SectionHead id="c-story" titleHtml={c.story.title} />
      <div class="c-story container--text">
        {c.story.paragraphs.map((html) => <p set:html={html} />)}
      </div>
    </section>

    <!-- 3b · Statement als eigene Sektion -->
    <section class="c-block" aria-label="Eine gute Marke erkennt man nicht nur. Du fühlst sie.">
      <div class="v-line" aria-hidden="true"></div>
      <div class="c-statement reveal-up">
        <CroissantArt mini class="c-statement__icon" />
        <p>
          <span class="c-statement__lead">{c.story.statementLead}</span>
          <em class="c-statement__punch">{c.story.statementPunch}</em>
        </p>
      </div>
    </section>

    <!-- 4 · Die Zutaten deiner Marke -->
    <section class="c-block" aria-label="Die Zutaten deiner Marke">
      <div class="c-split container">
        <figure class="c-split__media reveal">
          <Picture src={img.cafe.src} alt={img.cafe.alt} widths={[img.cafe.src.width]} sizes="(min-width: 48rem) 28rem, 90vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
        </figure>
        <div class="c-story c-split__text">
          {c.layers.paragraphs.map((html) => <p set:html={html} />)}
        </div>
      </div>
    </section>

    <!-- 5 · Sag mal, spürst du das auch? -->
    <section class="c-block" aria-labelledby="c-feel">
      <SectionHead id="c-feel" titleHtml={c.feel.title} textHtml={c.feel.textHtml} />
      <p class="c-feel__ask container--text">{c.feel.ask}</p>
      <div class="c-quiz container--text" data-quiz>
        <p class="c-quiz__hint"><span class="c-quiz__pulse" aria-hidden="true" />{c.feel.hint}</p>
        <ul role="list" class="c-quiz__list">
          {
            c.feel.questions.map((q, i) => (
              <li>
                <button type="button" class="c-quiz__q" aria-pressed="false" style={`--i:${i}`}>
                  <CroissantArt mini class="c-quiz__icon" />
                  <span>{q}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <div class="c-quiz__answer" aria-live="polite">
          <div class="c-quiz__meter" aria-hidden="true">
            {c.feel.questions.map(() => <CroissantArt mini class="c-quiz__meter-icon" />)}
          </div>
          <p class="c-quiz__count" data-quiz-count hidden></p>
          <p class="c-quiz__text is-empty" data-quiz-text data-hint={c.feel.empty} data-answers={JSON.stringify(c.feel.answers)}>{c.feel.empty}</p>
          <a class="btn btn--solid c-cta__btn c-quiz__cta" href="#einladung" data-quiz-cta hidden>
            <CroissantArt mini class="c-cta__icon" />
            {c.feel.cta}
          </a>
        </div>
      </div>
    </section>

    <!-- 6 · Warum gerade du? – nur beim Einstieg per QR-Code -->
    <section class="c-why c-only-qr container" aria-labelledby="c-why">
      <div class="c-why__media reveal">
        <Picture src={img.verpackung.src} alt={img.verpackung.alt} widths={[img.verpackung.src.width]} sizes="(min-width: 48rem) 22.5rem, 80vw" formats={['avif', 'webp']} loading="lazy" decoding="async" class="c-why__img" />
      </div>
      <div class="c-why__text">
        <p class="c-eyebrow">{c.why.eyebrow}</p>
        <h2 class="heading c-h2" id="c-why">{c.why.title}</h2>
        {c.why.paragraphs.map((p) => <p>{p}</p>)}
        <p class="c-signature">{c.why.signature}</p>
      </div>
    </section>

    <!-- 1 · Hero -->
    <div class="v-line" aria-hidden="true"></div>
    <section class="c-hero container" aria-labelledby="c-title">
      <div class="c-hero__art">
        <CroissantArt draw label="Feine Linienzeichnung eines Croissants" />
      </div>
      <div class="c-hero__text">
        <p class="c-eyebrow">{c.eyebrow}</p>
        <h2 class="c-title" id="c-title">
          <span class="c-variant c-variant--web">{c.hero.web.title}</span>
          <span class="c-variant c-variant--qr">{c.hero.qr.title}<br /><em>{c.hero.qr.titleSecond}</em></span>
        </h2>
        <p class="c-lead" set:html={c.hero.textHtml} />
        <p class="c-hero__tagline">{c.hero.tagline}</p>
        <div class="c-cta">
          <a class="btn btn--solid c-cta__btn" href="#einladung">
            <CroissantArt mini class="c-cta__icon" />
            {c.cta.label}
          </a>
        </div>
      </div>
    </section>

    <!-- 9 · Abschluss + Einladung -->
    <section class="c-final" id="einladung" aria-labelledby="c-final">
      <div class="v-line" aria-hidden="true"></div>
      <div class="container--text c-final__head">
        <h2 class="heading c-h2 c-final__title" id="c-final">{c.final.title}</h2>
        <p class="lead-text" set:html={c.final.textHtml} />
      </div>

      <form class="form c-form" action="/api/contact" method="post" novalidate data-contact-form>
        <div class="c-form__fields" data-form-fields>
          <p class="c-form__intro"><strong>{c.form.title}</strong> {c.form.text}</p>
          <div class="form__field">
            <label for="c-name">{fields.name} <span aria-hidden="true">*</span></label>
            <input id="c-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="c-name-err" />
            <p class="form__error" id="c-name-err" hidden>Verrätst du uns deinen Namen?</p>
          </div>
          <div class="form__field">
            <label for="c-company">{fields.company} <span aria-hidden="true">*</span></label>
            <input id="c-company" name="company" type="text" autocomplete="organization" required maxlength="160" aria-describedby="c-company-err" />
            <p class="form__error" id="c-company-err" hidden>Wie heißt deine Marke oder dein Unternehmen?</p>
          </div>
          <div class="form__field">
            <label for="c-webseite">{fields.website}</label>
            <input id="c-webseite" name="webseite" type="text" inputmode="url" autocomplete="url" maxlength="200" placeholder={fields.websitePlaceholder} />
          </div>
          <div class="form__field">
            <label for="c-email">{fields.email} <span aria-hidden="true">*</span></label>
            <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="c-email-err" />
            <p class="form__error" id="c-email-err" hidden>Bitte gib eine gültige E-Mail-Adresse an.</p>
          </div>
          <div class="form__field">
            <label for="c-phone">{fields.phone}</label>
            <input id="c-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
          </div>
          <div class="form__field">
            <label for="c-when">{fields.when}</label>
            <input id="c-when" name="when" type="text" maxlength="200" placeholder={fields.whenPlaceholder} />
          </div>
          <div class="form__field">
            <label for="c-message">{fields.message}</label>
            <textarea id="c-message" name="message" rows="3" maxlength="5000"></textarea>
          </div>

          <div class="form__hp" aria-hidden="true">
            <label for="c-website">Website</label>
            <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="ts" value="" data-ts />
          <input type="hidden" name="quelle" value="croissant" />
          <input type="hidden" name="design" value="" data-design-field />

          <p class="form__privacy">Mit dem Absenden werden deine Angaben zur Bearbeitung deiner Anfrage verwendet. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
          <div class="form__actions">
            <button class="btn btn--solid c-cta__btn" type="submit" data-label={c.form.submit} data-sending={c.form.sending}>{c.form.submit}</button>
          </div>
          <p class="c-cta__meta">{c.cta.meta}</p>
        </div>

        <div class="form__status" role="status" aria-live="polite" tabindex="-1" data-form-status>
          <p class="form__msg form__msg--ok c-form__ok" hidden data-ok>{c.form.success}</p>
          <p class="form__msg form__msg--err" hidden data-err>{c.form.error}</p>
        </div>
      </form>

      <p class="c-direct">
        {c.form.alternative}
        <a href={agency.whatsapp} target="_blank" rel="noopener">WhatsApp</a> ·
        <a href={`tel:${agency.phoneE164}`}>{agency.phone}</a> ·
        <a href={`mailto:${agency.email}`}>{agency.email}</a>
      </p>
    </section>
  </main>

  <Footer />

  <!-- Mobil: dezente Einladung am unteren Rand – erscheint nach dem Hero, verschwindet beim Formular -->
  <a class="c-sticky btn btn--solid" href="#einladung" data-sticky-cta>
    <CroissantArt mini class="c-cta__icon" />
    {c.cta.label}
  </a>
</Base>

<script>
  import '../scripts/contact-form';

  // Fragen zum Antippen: Antwort je nach Anzahl
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
    const text = quiz.querySelector<HTMLElement>('[data-quiz-text]')!;
    const count = quiz.querySelector<HTMLElement>('[data-quiz-count]')!;
    const cta = quiz.querySelector<HTMLElement>('[data-quiz-cta]')!;
    const buttons = [...quiz.querySelectorAll<HTMLButtonElement>('.c-quiz__q')];
    const meter = [...quiz.querySelectorAll<SVGElement>('.c-quiz__meter-icon')];
    const answers: { from: number; text: string }[] = JSON.parse(text.dataset.answers || '[]');
    const update = () => {
      const n = buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').length;
      let msg = text.dataset.hint || '';
      for (const a of answers) if (n >= a.from) msg = a.text;
      quiz.classList.add('is-touched');
      meter.forEach((m, k) => m.classList.toggle('is-on', k < n));
      text.classList.toggle('is-empty', n === 0);
      count.hidden = n === 0;
      count.textContent = `${n} von ${buttons.length}`;
      cta.hidden = n === 0;
      if (text.textContent !== msg) {
        text.classList.add('is-swap');
        setTimeout(() => {
          text.textContent = msg;
          text.classList.remove('is-swap');
        }, 200);
      }
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        update();
      }),
    );
  });

  const sticky = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector('.c-hero');
  const invite = document.getElementById('einladung');
  if (sticky && hero && invite) {
    let heroVisible = true;
    let inviteVisible = false;
    const update = () => sticky.classList.toggle('is-visible', !heroVisible && !inviteVisible);
    new IntersectionObserver(([e]) => {
      heroVisible = e.isIntersecting;
      update();
    }).observe(hero);
    new IntersectionObserver(([e]) => {
      inviteVisible = e.isIntersecting;
      update();
    }).observe(invite);
  }
</script>

<style>
  /* ---------- Kopf (wie Unterseiten) ---------- */
  .c-head {
    --c-ink-hero: var(--c-ink);
    padding-bottom: 1.5rem;
    text-align: center;
  }
  .c-head__brand {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--f-display);
    font-size: 1.25rem;
    text-decoration: none;
  }
  :global(:root[data-design='louder']) .c-head__brand {
    font-family: var(--f-bold);
    color: var(--c-accent);
    font-size: 1.75rem;
    letter-spacing: 1px;
  }
  :global(:root[data-design='louder']) .c-head__brand em {
    font-style: normal;
  }

  /* ---------- Bausteine ---------- */
  .c-eyebrow {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--c-ink-soft);
  }
  :global(:root[data-design='louder']) .c-eyebrow {
    font-family: var(--f-bold);
    font-style: normal;
    text-transform: lowercase;
    letter-spacing: 1px;
    color: #000;
  }
  .c-h2 {
    text-align: left;
  }
  .c-block {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  /* Croissant-Strich: Tinte in minimal, Orange in louder */
  .croissant :global(.croissant-art) {
    color: var(--c-ink);
  }
  :global(:root[data-design='louder']) .croissant :global(.croissant-art) {
    color: #000;
    --croissant-fill: var(--c-accent);
  }
  /* Croissant im Button übernimmt die Button-Schriftfarbe */
  .croissant :global(.c-cta__icon),
  :global(:root[data-design='louder']) .croissant :global(.c-cta__icon) {
    color: inherit;
    --croissant-fill: transparent;
  }

  /* ---------- 1 · Hero ---------- */
  .c-hero {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    min-height: calc(100svh - 9rem);
    padding: 1rem 0 3rem;
  }
  .c-hero__art {
    width: min(78%, 22rem);
    margin-inline: auto;
  }
  .c-hero__text {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .c-title {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3.125rem);
    line-height: 1.2;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  .c-title em {
    display: inline-block;
    margin-top: 0.2em;
    font-style: italic;
    font-size: 0.7em;
  }
  :global(:root[data-design='louder']) .c-title {
    font-family: var(--f-bold);
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.75rem);
    letter-spacing: 1px;
    line-height: 1.05;
    text-transform: lowercase;
    color: var(--c-heading);
  }
  :global(:root[data-design='louder']) .c-title em {
    font-style: normal;
    color: #000;
  }
  /* Zwei Einstiege: Standard = Website; per QR-Code = „Du hast ein Croissant bekommen.“ */
  .c-variant--qr {
    display: none;
  }
  :global(.croissant-qr) .c-variant--web {
    display: none;
  }
  :global(.croissant-qr) .c-variant--qr {
    display: inline;
  }
  /* Sektionen nur für Croissant-Empfänger (QR-Code) */
  :global(html:not(.croissant-qr)) .c-only-qr {
    display: none;
  }
  .c-lead {
    max-width: 34rem;
    font-size: 1.0625rem;
  }
  .c-hero__tagline {
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    color: var(--c-heading);
  }
  .c-steps {
    display: grid;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem 0;
    text-align: left;
    font-size: 0.9375rem;
  }
  .c-steps li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .c-steps :global(.c-steps__icon) {
    flex: none;
    width: 1.35rem;
  }
  :global(:root[data-design='louder']) .c-hero__tagline {
    font-family: var(--f-body);
    font-style: normal;
    font-weight: 600;
  }
  .c-cta {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    margin-top: 0.5rem;
  }
  .c-cta__meta {
    font-size: 0.8125rem;
    color: var(--c-ink-soft);
  }
  .c-scroll {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: var(--w-regular);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (min-width: 48rem) {
    .c-hero {
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(2rem, 6vw, 5rem);
      padding-top: 2rem;
    }
    .c-hero {
      align-items: start;
      min-height: 0;
    }
    .c-hero__art {
      order: 2;
      width: 100%;
      margin-top: var(--hero-art-shift, 0);
    }
  }

  /* ---------- 2 · Warum ein Croissant … ---------- */
  /* Wie der Header der Startseite: Foto bleibt stehen, Headline gleitet beim Scrollen weg (parallax-hero) */
  .c-why1 {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: max(30rem, calc(100svh - 11rem));
    padding: 4rem 0;
    text-align: center;
    color: #fff;
    clip-path: inset(0);
  }
  .c-why1__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .c-why1__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  @media (min-width: 64rem) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .c-why1__media {
      position: fixed;
      height: 100vh;
    }
  }
  .c-why1::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 0.28);
  }
  .c-why1__inner {
    width: 100%;
  }
  .c-why1__title {
    font-family: var(--f-display);
    font-weight: var(--w-regular);
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.5rem);
    line-height: 1.2;
    color: #fff;
    text-shadow: 0 1px 24px rgb(0 0 0 / 0.25);
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  .c-why1__title :global(.c-why1__icon) {
    display: inline-block;
    width: 1.6em;
    vertical-align: -0.12em;
    margin-inline: 0.1em;
    color: #fff;
    --croissant-stroke: 1.3;
  }
  .c-why1__sub {
    margin-top: 1.25rem;
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--c-ink-soft);
  }
  :global(:root[data-design='louder']) .c-why1__title {
    font-family: var(--f-bold);
    letter-spacing: 1px;
    line-height: 1.15;
    text-transform: lowercase;
